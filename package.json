{
  "name": "playdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/integrations/next-image/.prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/integrations/next-image/.prettierignore",
    "lint": "eslint . --ignore-pattern '**/.next/**'",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:storybook": "pnpm --filter @playdeck/storybook test",
    "test:integrations": "turbo run build --filter=@playdeck/integration-next-image && pnpm --filter @playdeck/integration-next-image test:integration",
    "test:packages": "node scripts/verify-packaging.mjs",
    "test:deploy": "node scripts/check-deploy-artifact.mjs",
    "test:site-links": "node scripts/check-site-links.mjs",
    "test:site-analytics": "node scripts/check-site-analytics.mjs",
    "test:site-fences": "node scripts/check-rendered-fences.mjs",
    "test:budgets": "node scripts/check-bundle-budgets.mjs",
    "test:story-fixtures": "node scripts/story-fixtures.mjs",
    "media:sprite-fright": "node scripts/media-sprite-fright.mjs",
    "test:bundle": "turbo run build --filter=@playdeck/bundle-native-only --filter=@playdeck/bundle-no-build --filter=@playdeck/bundle-thumbnails && pnpm --filter @playdeck/bundle-native-only test && pnpm --filter @playdeck/bundle-no-build test && pnpm --filter @playdeck/bundle-thumbnails test",
    "test:docs": "node --test scripts/docs-examples.test.mjs",
    "test:audit": "node scripts/audit.mjs",
    "test:audit-unit": "node --test scripts/audit.test.mjs scripts/bundle-budgets.test.mjs scripts/check-deploy-artifact.test.mjs scripts/check-rendered-fences.test.mjs scripts/client-boundary.test.mjs scripts/compare-features.test.mjs scripts/compare-libraries.test.mjs scripts/esm-only-guard.test.mjs scripts/gate-parser.test.mjs scripts/packaging-fixture.test.mjs scripts/readme-bytes.test.mjs scripts/release-tags.test.mjs scripts/resolution-modes.test.mjs scripts/shipped-changelog.test.mjs scripts/site-build-inputs.test.mjs scripts/story-fixtures.test.mjs scripts/workspace-packages.test.mjs",
    "docs:examples": "node scripts/docs-examples.mjs",
    "docs:check": "node scripts/docs-examples.mjs --check",
    "docs:bytes": "node scripts/readme-bytes.mjs",
    "docs:bytes:check": "node scripts/readme-bytes.mjs --check",
    "compare:libraries": "node scripts/compare-libraries.mjs",
    "compare:libraries:check": "node scripts/compare-libraries.mjs --check",
    "compare:features": "node scripts/compare-features.mjs",
    "compare:features:check": "node scripts/compare-features.mjs --check",
    "build": "turbo run build",
    "changeset": "changeset",
    "version:packages": "changeset version && node scripts/release-tags.mjs --list",
    "tag:packages": "node scripts/release-tags.mjs",
    "prerelease:enter": "changeset pre enter next",
    "prerelease:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playdeck/test-support": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "hls.js": "1.7.3",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "publint": "0.3.24",
    "react": "19.3.0",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.141.0",
    "yaml": "2.9.1"
  }
}
