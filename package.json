{
  "name": "playdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/integrations/next-image/.prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/integrations/next-image/.prettierignore",
    "lint": "eslint . --ignore-pattern '**/.next/**'",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:storybook": "pnpm --filter @playdeck/storybook test",
    "test:integrations": "turbo run build --filter=@playdeck/integration-next-image && pnpm --filter @playdeck/integration-next-image test:integration",
    "test:packages": "node scripts/verify-packaging.mjs",
    "test:deploy": "node scripts/check-deploy-artifact.mjs",
    "test:site-links": "node scripts/check-site-links.mjs",
    "test:budgets": "node scripts/check-bundle-budgets.mjs",
    "test:story-fixtures": "node scripts/story-fixtures.mjs",
    "test:bundle": "turbo run build --filter=@playdeck/bundle-native-only && pnpm --filter @playdeck/bundle-native-only test",
    "test:docs": "node --test scripts/docs-examples.test.mjs",
    "test:audit": "node scripts/audit.mjs",
    "test:audit-unit": "node --test scripts/audit.test.mjs scripts/bundle-budgets.test.mjs scripts/client-boundary.test.mjs scripts/esm-only-guard.test.mjs scripts/gate-parser.test.mjs scripts/packaging-fixture.test.mjs scripts/readme-bytes.test.mjs scripts/release-tags.test.mjs scripts/resolution-modes.test.mjs scripts/shipped-changelog.test.mjs scripts/story-fixtures.test.mjs scripts/workspace-packages.test.mjs",
    "docs:examples": "node scripts/docs-examples.mjs",
    "docs:check": "node scripts/docs-examples.mjs --check",
    "docs:bytes": "node scripts/readme-bytes.mjs",
    "docs:bytes:check": "node scripts/readme-bytes.mjs --check",
    "build": "turbo run build",
    "changeset": "changeset",
    "version:packages": "changeset version && node scripts/release-tags.mjs --list",
    "tag:packages": "node scripts/release-tags.mjs",
    "prerelease:enter": "changeset pre enter next",
    "prerelease:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.12.1",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@playdeck/test-support": "workspace:*",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "happy-dom": "20.8.9",
    "hls.js": "1.6.16",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "turbo": "2.10.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.127.1",
    "yaml": "2.9.0"
  }
}
