{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": [],
    // The docs examples are what a consumer copies, so they are checked against
    // the built declarations rather than package source: an example that only
    // compiles against `src` can still be wrong for someone who ran
    // `pnpm add @playdeck/core`. Same reasoning as e2e/tsconfig.json.
    "paths": {
      "@playdeck/core": ["../packages/core/dist/index.d.ts"],
      "@playdeck/react": ["../packages/react/dist/index.d.ts"],
      "@playdeck/provider-native": [
        "../packages/provider-native/dist/index.d.ts"
      ],
      "@playdeck/provider-hls": ["../packages/provider-hls/dist/index.d.ts"],
      "@playdeck/provider-youtube": [
        "../packages/provider-youtube/dist/index.d.ts"
      ],
      "@playdeck/provider-vimeo": [
        "../packages/provider-vimeo/dist/index.d.ts"
      ],
      "@playdeck/provider-wistia": [
        "../packages/provider-wistia/dist/index.d.ts"
      ]
    },
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/examples.tsbuildinfo"
  },
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/react" },
    { "path": "../packages/provider-native" },
    { "path": "../packages/provider-hls" },
    { "path": "../packages/provider-youtube" },
    { "path": "../packages/provider-vimeo" },
    { "path": "../packages/provider-wistia" }
  ],
  "include": ["*.ts", "*.tsx"]
}
