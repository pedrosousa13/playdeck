node_modules/
# Covers the site's search index too: Pagefind writes it into
# `apps/site/dist/pagefind/` after Astro has emitted the pages, so it is inside
# the build output rather than beside it, and it is never committed for the same
# reason nothing else in there is — it is derived from the pages on every build.
dist/
# The site built a second time under a non-root prefix, by
# `apps/site`'s `build:based`. `e2e/site-search.spec.ts` searches it to prove
# the base path is derived rather than written down; it ships nowhere.
apps/site/dist-base/
.worktrees/
storybook-static/
# Astro's generated ambient types, written by `astro sync` and by every build.
# Build output, so never committed -- `apps/site/tsconfig.json` records why it
# is also outside what `tsc -b` reads.
.astro/
# The assembled deployment, composed from the two build outputs above by
# scripts/assemble-deploy.mjs and published as the Worker's assets (#519).
deploy-dist/
*storybook.log
playwright-report/
test-results/
*.tsbuildinfo
.turbo/
.scratch/
.factory/journal.json
# main's copy of scripts/, fetched by the `audit` and `package` jobs in
# .github/workflows/ci.yml and run from there. Never committed: a copy that
# lived in the tree would be editable by the pull request it judges, which is
# the whole point of it.
.gate/
# main's manifests and workspace file, fetched by the same job and the same
# fetch, and the publishable boundary the gate compares against (#373). Never
# committed, for the same reason: a copy in the tree would be the pull
# request's declaration of what main publishes.
.gate-baseline/

# Brainstorming mockups pushed to the visual companion's local server. Working
# material for one session, never part of the site or its build.
.superpowers/

# Local environment files, anywhere in the tree. Nothing in this repository
# reads one at build time -- the deploy's two Cloudflare credentials are
# GitHub Actions secrets, named in .github/workflows/deploy-site.yml and held
# nowhere else -- so a `.env` here is a maintainer's own scratch copy of
# something secret and must never be committable. Ignored by name rather than
# by path because Astro loads `apps/<app>/.env` as readily as a root one, and
# the rule that stops the mistake has to cover both.
#
# `.env.example` stays committable: a file of key names with no values is
# documentation, and is the thing a `.env` should be derived from.
.env
.env.*
!.env.example
