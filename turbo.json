{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tsbuildinfo", ".next/**", "storybook-static/**"]
    },
    // The site is the one package that builds files from outside its own
    // directory: `src/pages/examples.astro` imports the two compositions in
    // `examples/`, `src/content.config.ts` loads the package READMEs, the
    // manifests it and `src/comparison-page.mjs`/`src/provider-pages.mjs`
    // read for a package's repository URL, `docs/provider-setup.md`, the
    // library comparison guide's three source documents in `docs/comparison/`,
    // and the workbench's own `apps/storybook/stories/*.mdx` guides, and
    // `src/pages/index.astro` and `src/pages/start.astro` import
    // `scripts/bundle-budgets.mjs` and `scripts/readme-bytes.mjs` to measure
    // the figures they print -- every one of those, in turn, asks
    // `scripts/workspace-packages.mjs` which packages are publishable. Turbo's
    // default input set is the package's own tracked files, so an edit to any
    // of those left the cached build valid and a `turbo run build` replayed a
    // site that did not contain it. Playwright's `webServer` builds through
    // Turbo and without `--force`, so the archetype e2e specs could pass
    // against a stale site.
    //
    // `$TURBO_DEFAULT$` keeps the package's own files in the set and adds
    // these beside them, rather than replacing them.
    // `scripts/site-build-inputs.test.mjs` catches a regression of the same
    // shape for a plain relative import crossing this package's boundary --
    // it cannot see a path built at runtime from a string, the way
    // `docs/provider-setup.md`, `docs/comparison/**`,
    // `apps/storybook/stories/*.mdx`, `packages/*/README.md` and
    // `packages/*/package.json` are all read through `join(repoRoot, ...)`
    // rather than imported, so those five stay a manual audit.
    "@playdeck/site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../examples/**",
        "../../docs/provider-setup.md",
        "../../docs/comparison/**",
        "../../apps/storybook/stories/*.mdx",
        "../../packages/*/README.md",
        "../../packages/*/package.json",
        "../../scripts/bundle-budgets.mjs",
        "../../scripts/readme-bytes.mjs",
        "../../scripts/workspace-packages.mjs"
      ],
      "outputs": ["dist/**"]
    }
  }
}
