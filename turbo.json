{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tsbuildinfo", ".next/**", "storybook-static/**"]
    },
    // The site is the one package that builds files from outside its own
    // directory: `src/pages/archetypes.astro` imports the two compositions in
    // `examples/`, `src/content.config.ts` loads the package READMEs and
    // `docs/provider-setup.md`, and `src/pages/index.astro` imports
    // `scripts/bundle-budgets.mjs` to measure the figures it prints. Turbo's
    // default input set is the package's own tracked files, so an edit to any
    // of those left the cached build valid and a `turbo run build` replayed a
    // site that did not contain it. Playwright's `webServer` builds through
    // Turbo and without `--force`, so the archetype e2e specs could pass
    // against a stale site.
    //
    // `$TURBO_DEFAULT$` keeps the package's own files in the set and adds these
    // four beside them, rather than replacing them.
    "@playdeck/site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../examples/**",
        "../../docs/provider-setup.md",
        "../../packages/*/README.md",
        "../../scripts/bundle-budgets.mjs"
      ],
      "outputs": ["dist/**"]
    }
  }
}
