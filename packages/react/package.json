{
  "name": "@reely/react",
  "version": "0.0.0",
  "description": "Headless, composable React 19 media player primitives with capability-aware providers.",
  "keywords": [
    "media",
    "player",
    "video",
    "react",
    "headless",
    "hls",
    "youtube",
    "vimeo",
    "accessibility"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pedrosousa13/reely/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/reely.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/pedrosousa13/reely/issues"
  },
  "type": "module",
  "sideEffects": false,
  "browserslist": [
    "chrome >= 99",
    "edge >= 99",
    "firefox >= 97",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/.tsbuildinfo*",
    "theme.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@reely/core": "workspace:^",
    "@reely/provider-hls": "workspace:^",
    "@reely/provider-native": "workspace:^",
    "@reely/provider-vimeo": "workspace:^",
    "@reely/provider-wistia": "workspace:^",
    "@reely/provider-youtube": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "vite build && tsc -b",
    "test": "vitest run --config ../../vitest.config.ts packages/react/test"
  }
}
