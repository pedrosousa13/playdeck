{
  "name": "@playdeck/core",
  "version": "1.0.0",
  "description": "Framework-neutral player state, commands, events and provider contract for Playdeck.",
  "keywords": [
    "media",
    "player",
    "video",
    "state",
    "headless"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pedrosousa13/playdeck/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/playdeck.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pedrosousa13/playdeck/issues"
  },
  "type": "module",
  "sideEffects": [
    "./esm-only.cjs"
  ],
  "browserslist": [
    "chrome >= 99",
    "edge >= 99",
    "firefox >= 97",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./esm-only.d.cts",
        "default": "./esm-only.cjs"
      }
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/.tsbuildinfo*",
    "esm-only.cjs",
    "esm-only.d.cts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -b",
    "test": "vitest run --config ../../vitest.config.ts packages/core/test"
  }
}
