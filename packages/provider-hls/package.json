{
  "name": "@playdeck/provider-hls",
  "version": "0.1.1",
  "description": "HLS provider for Playdeck, over hls.js or the browser’s native HLS.",
  "keywords": [
    "media",
    "player",
    "video",
    "hls",
    "hls.js"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pedrosousa13/playdeck/tree/main/packages/provider-hls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/playdeck.git",
    "directory": "packages/provider-hls"
  },
  "bugs": {
    "url": "https://github.com/pedrosousa13/playdeck/issues"
  },
  "type": "module",
  "sideEffects": false,
  "browserslist": [
    "chrome >= 99",
    "edge >= 99",
    "firefox >= 97",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/.tsbuildinfo*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@playdeck/core": "workspace:^",
    "@playdeck/provider-native": "workspace:^",
    "hls.js": "1.6.16"
  },
  "scripts": {
    "build": "vite build && tsc -b",
    "test": "vitest run --config ../../vitest.config.ts packages/provider-hls/test"
  }
}
