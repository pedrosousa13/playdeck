{
  "name": "@reely/provider-vimeo",
  "version": "0.0.0",
  "description": "Vimeo player SDK provider for Reely.",
  "keywords": [
    "media",
    "player",
    "video",
    "vimeo"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pedrosousa13/reely/tree/main/packages/provider-vimeo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/reely.git",
    "directory": "packages/provider-vimeo"
  },
  "bugs": {
    "url": "https://github.com/pedrosousa13/reely/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/.tsbuildinfo*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@reely/core": "workspace:^",
    "@vimeo/player": "2.30.4"
  },
  "scripts": {
    "build": "vite build && tsc -b",
    "test": "vitest run --config ../../vitest.config.ts packages/provider-vimeo/test"
  }
}
