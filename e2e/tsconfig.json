{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node"],
    // The specs drive the player through its published handle, so they are
    // checked against the built declarations rather than a hand-written shape.
    "paths": { "@playdeck/react": ["../packages/react/dist/index.d.ts"] },
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/e2e.tsbuildinfo"
  },
  "references": [{ "path": "../packages/react" }],
  // `contrast.ts` and `highlight-ms.ts` are listed by hand rather than reached
  // through a project reference: each belongs to a `noEmit` project
  // (`packages/react/tsconfig.test.json`, `apps/site/tsconfig.json`) and so
  // cannot be referenced. `contrast.ts` -- both projects type-check the same
  // source file, which is the point -- `thumb-contrast.spec.ts` measures the
  // boundaries `theme.test.ts` computes, and the two are only comparable while
  // one module does the WCAG maths for both (#190). `highlight-ms.ts` -- same
  // reason: `site-bench.spec.ts` and `CompositionPanel.tsx` both build off
  // the one `HIGHLIGHT_MS` (#744).
  "include": [
    ".",
    "../playwright.config.ts",
    "../packages/react/test/contrast.ts",
    "../apps/site/src/components/highlight-ms.ts"
  ]
}
