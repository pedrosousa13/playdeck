---
/**
 * The document every page of this site is served inside: the head, the
 * stylesheet, and the one script that has to run before the browser paints.
 *
 * A layout rather than markup repeated per page, because the theme script below
 * is not optional decoration — a page that forgot it would flash the wrong
 * theme, and a defect that only appears on a page somebody forgot something on
 * is the kind worth making structurally impossible.
 *
 * That script is inline, unbundled and first in the head, all three for the
 * same reason: it has to have run before the first paint. A module script —
 * which is what Astro produces without `is:inline` — is deferred by definition
 * and runs after the document is parsed, so the reader would see the light
 * theme painted and then replaced. A theme that arrives in two steps is worse
 * than no theme switch at all.
 *
 * It sets `data-theme` only when a choice is stored. Leaving the attribute
 * unset otherwise is what hands the decision to `tokens.css`'s
 * `prefers-color-scheme` block, which is both correct with no JavaScript at all
 * and live to the operating system changing its mind.
 */

// Imported here rather than linked from the head, so the build hashes the
// stylesheet, follows its `@import`s and emits the font files it references
// beside it. A hand-written `<link>` to a source path would ship a URL that
// only exists during development.
import '../styles/base.css';

interface Props {
  title: string;
  /**
   * Whether this page belongs in the documentation search index. True unless a
   * page says otherwise, which is the important half: Pagefind walks the built
   * `dist/` after the build and indexes every page that does not opt out, so a
   * documentation page added later is searchable with nothing to remember. The
   * cost of that default is that a page which is *not* documentation has to say
   * so, and there are exactly two — `/` and `/design`.
   *
   * `SiteHeader.astro` takes a prop of the same name for the other half of the
   * same decision, whether the page carries the search control. See its header
   * for why they are two props rather than one.
   */
  documentation?: boolean;
  /**
   * Which of the site's two page treatments this page is served in, written to
   * the `<body>` as `data-stance`.
   *
   * `document` unless a page says otherwise, and the default is the important
   * half: every route here except `/` is a document — the reference pages, the
   * provider pages, the archetypes and this system's own specimen sheet — so a
   * page added later gets the quiet treatment with nothing to remember, and the
   * one page that argues has to say so. `argument` buys larger type, more
   * space, and the entry motion `base.css` keys off this attribute; keying it
   * here rather than on a class is what stops a document page growing scattered
   * reveals by accident.
   *
   * `/archetypes` is a `document` deliberately rather than by omission: the
   * persuading happens on `/`, and that page exists so a reader can read the
   * source.
   *
   * **This is not the same axis as `documentation` above**, and the two are
   * only correlated. `documentation` answers whether a page belongs in the
   * search index; `stance` answers how it is dressed. `/design` is
   * `documentation={false}` — it is this system's specimen sheet and not
   * something to find by searching for a word in it — and `stance="document"`
   * all the same, because it reads as a document. Collapsing them into one prop
   * would make either fact unstatable without the other.
   */
  stance?: 'argument' | 'document';
}

const { title, documentation = true, stance = 'document' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // `'playdeck-theme'` is duplicated from `ThemeToggle.astro`'s
      // `STORAGE_KEY` and the two have to stay identical: change one and the
      // theme still switches on a click but silently stops surviving a reload,
      // which nothing here would fail on. They cannot share a module, because
      // this script is `is:inline` precisely so it runs before first paint and
      // an inline script cannot import.
      try {
        const stored = localStorage.getItem('playdeck-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        // Storage can throw rather than return null when a reader blocks it.
        // The unset attribute that results is the correct fallback anyway.
      }
    </script>
  </head>
  {
    /* `data-pagefind-ignore` on the `<body>` is how Pagefind is told to skip a
     * page entirely rather than merely to skip a region of it, so this is the
     * whole of the opt-out. Written as `undefined` rather than `false` because
     * Pagefind reads the attribute's presence and not its value — `data-
     * pagefind-ignore="false"` would exclude the page just as firmly. */
  }
  <body data-pagefind-ignore={documentation ? undefined : true} data-stance={stance}>
    <slot />
  </body>
</html>
