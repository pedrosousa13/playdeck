---
/**
 * The narrow sticky column beside a long document: which document, and where in
 * this one.
 *
 * It was written for the reference pages and is a component because the
 * provider setup pages (#524) are the second set of long documents this site
 * renders and wanted exactly it — the same disclosure, the same sticky
 * behaviour, the same two lists. A copy would have been a second description of
 * one design decision, and the failure would have been the quiet kind: the rail
 * on one set of pages fixed and the rail on the other not.
 *
 * What it is not is a general navigation component. It takes one group of
 * sibling documents and one table of contents, in that order, because that is
 * what a rail on this site means; a page wanting a third list is a change to
 * this file rather than a prop.
 *
 * ---- the two lists ---------------------------------------------------------
 *
 * `group` is the sibling documents — the packages, or the providers — with the
 * current one marked. `aria-current="page"` is what marks it, so the marking is
 * announced rather than only visible, and the weight and colour that go with it
 * are the visual half of the same fact.
 *
 * `label.note` is the part every name in the group shares, stated once above
 * the column instead of repeated down it: `@playdeck/` spent the width that
 * tells `provider-vimeo` from `provider-wistia` on characters identical in
 * every row. An item whose visible label is a fragment of its real name carries
 * the rest in `hiddenPrefix`, present for assistive technology and absent for
 * everyone else, because `core` on its own is not what a reader would say out
 * loud.
 *
 * `contents` is the document's own headings, passed in from the same parse that
 * produced the document rather than written down anywhere. Depth 1 is the
 * page's own title and depth 4 restates an outline instead of being something a
 * reader jumps with, so a caller filters to 2 and 3; this component indents by
 * whatever depth it is handed.
 */

interface RailItem {
  href: string;
  label: string;
  /** Announced before `label`, and drawn for nobody. */
  hiddenPrefix?: string;
  current?: boolean;
}

interface Props {
  /** The `nav` landmark's accessible name. */
  label: string;
  group: {
    label: string;
    /** The prefix every name in the group shares, if they share one. */
    note?: string;
    /** Names that are identifiers are set in the mono face; prose is not. */
    mono?: boolean;
    items: RailItem[];
  };
  contents: { depth: number; slug: string; text: string }[];
}

const { label, group, contents } = Astro.props;
---

{
  /* One `nav` holding both lists rather than two landmarks, because they answer
   * the same question at two scales: which document, and where in it. The
   * headings inside it are the labels a screen reader lists them by. */
}
{
  /* `data-pagefind-ignore`, for the reason the site header carries it: this
   * rail is repeated on every document page, so indexed it would put the same
   * navigation into the excerpt of every result and make a document's name
   * match every other document. It sits here rather than on each caller, so a
   * new route that renders a rail is excluded by having one rather than by
   * remembering to say so. The headings themselves are still indexed where
   * they belong — in the document beside this, which is where a result should
   * land a reader. */
}
<nav class="rail" aria-label={label} data-pagefind-ignore>
  {
    /* A disclosure, closed, which the script below opens for real once there is
     * a column to put it in.
     *
     * Stacked above the document on a phone, these two lists run to roughly the
     * height of a phone screen several times over — a link per sibling
     * document, an entry per heading — so a reader who followed a link on a
     * narrow screen scrolled past the whole of the site's navigation before
     * reaching the first word of the document they asked for. Moving the rail
     * below the document was the other option and it is worse: the source order
     * is what a screen reader and a keyboard follow, and it would have put the
     * navigation somewhere neither of them meets it until after several hundred
     * lines of prose.
     *
     * `<details>` rather than a button and a script, because it is the element
     * the platform already made for this: the affordance, the keyboard
     * behaviour and the focus ring all arrive with no JavaScript, and with none
     * the page is a working closed disclosure at every width.
     *
     * What the script adds is the one thing CSS cannot do: change the element's
     * own state. The wide layout wants the rail permanently revealed, and the
     * ways to get there with CSS alone all reveal the content while leaving the
     * element closed — so a screen reader is told "collapsed" about a list the
     * reader is looking at, and at that width the only control that could
     * correct it has been taken out of the tree as well. `open` is a property,
     * not a presentation, and the accessible state follows it; so the property
     * is what gets set. */
  }
  <details class="rail__disclosure" data-rail>
    <summary class="rail__summary">
      <span class="rail__marker" aria-hidden="true">▸</span>Contents
    </summary>
    <div class="rail__inner">
      <section class="rail__group" data-mono={group.mono ? '' : undefined}>
        <h2 class="rail__label">
          <span>{group.label}</span>
          {group.note && <code class="rail__scope">{group.note}</code>}
        </h2>
        <ul class="rail__list">
          {
            group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                >
                  {item.hiddenPrefix && (
                    <span class="u-visually-hidden">{item.hiddenPrefix}</span>
                  )}
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rail__group">
        <h2 class="rail__label"><span>On this page</span></h2>
        <ul class="rail__list rail__list--toc">
          {
            contents.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <slot name="foot" />
    </div>
  </details>
</nav>

{
  /* `is:inline`, and written here rather than bundled, for the reason
   * `Base.astro`'s theme script is: a module script is deferred by definition,
   * so it would run after the document had already been laid out and the rail
   * would be seen to open. Inline and immediately after the element, it runs
   * while the parser is still working through the page.
   *
   * It owns two things and they are the same decision seen twice: whether the
   * element is open, which is what assistive technology is told, and
   * `data-rail`, which is what the stylesheet keys the column layout off.
   * Neither is written without the other, so the announced state and the
   * visible state cannot disagree — at a narrow width a closed disclosure with
   * its summary, at a wide one an open element whose summary is gone because
   * there is nothing left for it to toggle.
   *
   * `60rem` is the same figure as the media queries in this file's stylesheet,
   * which is the drift worth naming: the two are a few lines apart on purpose,
   * because a query cannot read a custom property and there is no way to state
   * the breakpoint once.
   *
   * With no JavaScript at all nothing here runs, `data-rail` stays empty, and
   * the rules below it never match — leaving the closed disclosure the markup
   * already is, at every width, with its summary visible, keyboard operable and
   * announcing the state it is actually in. */
}
<script is:inline>
  {
    const rail = document.querySelector('[data-rail]');
    const columned = window.matchMedia('(min-width: 60rem)');

    const apply = () => {
      rail.open = columned.matches;
      rail.dataset.rail = columned.matches ? 'column' : 'disclosure';
    };

    apply();
    columned.addEventListener('change', apply);
  }
</script>

<style>
  .rail {
    font-size: var(--text-sm);
  }

  /* The disclosure's own affordance: a row with a marker, a pointer target tall
   * enough to hit, and the site's focus ring from `base.css`. The default
   * triangle is replaced by one drawn from the same character in both states,
   * rotated — a `transform`, which is one of the two properties this site
   * animates, so it settles correctly with reduced motion. */
  .rail__summary {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--hit-target);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    cursor: pointer;
    background-color: var(--color-surface);
    border: var(--line-width) solid var(--color-line-strong);
    border-radius: var(--radius-md);
    list-style: none;
  }

  /* Belt and braces, and named as that rather than as a fact about a browser.
   * `list-style: none` above is what removes the marker in every engine this
   * has been opened in; WebKit once needed this pseudo element as well, and no
   * engine has been checked here to establish that it still does. The rule
   * costs one selector and removes a marker that is already gone, so it stays
   * until somebody has a reason to say otherwise. */
  .rail__summary::-webkit-details-marker {
    display: none;
  }

  /* An element in the markup rather than generated content, and hidden from
   * assistive technology rather than left to be read. Generated content is
   * announced — the breadcrumb separator in `SiteHeader.astro` relies on that
   * being so — and a marker announced here lands inside the accessible name of
   * the control itself, which becomes the glyph plus the word. The name is what
   * a reader hears before deciding whether this is the thing that opens the
   * navigation, so it is the word alone; the triangle is decoration on it. */
  .rail__marker {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    transition: transform var(--duration-fast) var(--ease);
  }

  .rail__disclosure[open] > .rail__summary > .rail__marker {
    transform: rotate(90deg);
  }

  .rail__summary:hover {
    color: var(--color-accent);
  }

  .rail__summary:active {
    color: var(--color-ink-subtle);
  }

  .rail__disclosure[open] > .rail__summary {
    margin-block-end: var(--space-4);
  }

  /* Sticky, and bounded by the viewport with its own scroller. A sticky element
   * taller than the window is the failure this guards: it pins at the top, its
   * tail hangs past the bottom edge, and page scrolling never brings that tail
   * back because the element is not moving. Capping the height and giving it a
   * scroller of its own means every entry stays reachable however many sections
   * the document it indexes turns out to have. */
  @media (min-width: 60rem) {
    /* Wide enough for a column, so the disclosure stops being one — but only
     * once the script has opened it for real. Keyed off the attribute that
     * script writes rather than off the width alone, because a summary hidden
     * at a width where nothing had opened the element would leave the rail
     * unreachable. */
    .rail__disclosure[data-rail='column'] > .rail__summary {
      display: none;
    }

    /* The chain a sticky element needs, and the reason the grid no longer
     * aligns its items to `start`. `position: sticky` travels inside its own
     * containing block, so an element exactly as tall as its parent has nowhere
     * to travel and simply scrolls away — which is what the rail did before
     * this, never sticking at any scroll offset. Each box between the grid row
     * and the sticky one is given the row's height instead: the rail by
     * stretching, the disclosure by asking for it.
     *
     * Unconditional, and that is the correction: a reader who opens the rail by
     * hand in an engine with no `::details-content`, or with no JavaScript in
     * any engine, gets a sticky element inside a box exactly its own height —
     * which is the original defect, kept alive for exactly those readers. */
    .rail,
    .rail__disclosure {
      block-size: 100%;
    }

    /* The third box in that chain, and the only part of it that is a pseudo
     * element the engine may not have. `::details-content` is the anonymous box
     * the user agent puts between a `<details>` and its content, so where it
     * exists the height has to pass through it; where it does not, there is no
     * box between the two and the two rules above are the whole chain. */
    @supports selector(::details-content) {
      .rail__disclosure::details-content {
        block-size: 100%;
      }
    }

    .rail__inner {
      position: sticky;
      inset-block-start: var(--space-5);
      max-block-size: calc(100vh - var(--space-7));
      overflow-y: auto;
      /* Thin, because the rail is 16rem wide and a platform-width bar down its
       * edge would read as a second column boundary. The colour is the root's. */
      scrollbar-width: thin;
      /* Room for the scrollbar the line above can produce, so a link's focus
       * ring is never clipped by the scroller's own edge. */
      padding-inline-end: var(--space-2);
    }
  }

  .rail__group + .rail__group {
    margin-block-start: var(--space-5);
  }

  /* An `h2` by role, so the rail's two lists are labelled in the document
   * outline, and at the caption rung rather than the section rung, because the
   * heading it labels is not competing with the document's own. Capitals are
   * left alone: a tracked uppercase label is the eyebrow tell in another
   * position. */
  .rail__label {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    margin-block-end: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-subtle);
    letter-spacing: normal;
  }

  /* The shared prefix, stated once at the head of the column it was repeated
   * down. Regular weight, so it reads as the thing the names below complete
   * rather than as a second label. */
  .rail__scope {
    font-family: var(--font-mono);
    font-size: var(--text-fn);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-fn);
  }

  .rail__list {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .rail__list a {
    display: block;
    padding-block: var(--space-1);
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .rail__list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Pressed, restating `base.css`'s rule because the hover above outranks it. */
  .rail__list a:active {
    color: var(--color-ink-subtle);
  }

  /* Package names are identifiers and are set in the mono face wherever they
   * appear on this site, which is also what joins each one to the `@playdeck/`
   * above the column. A provider's name is a proper noun and is not, so the
   * caller says which it has rather than this file assuming. */
  .rail__group[data-mono] .rail__list a {
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-fn);
  }

  /* The current document, marked by the same attribute that tells a screen
   * reader which one it is rather than by a class that only says it visually.
   * Weight and colour together, because colour alone is not a state. */
  .rail__list a[aria-current='page'] {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .rail__list--toc a {
    font-size: var(--text-xs);
  }

  /* Indent by the heading's own depth, so the rail carries the document's
   * hierarchy rather than flattening it. */
  .rail__list--toc li[data-depth='3'] a {
    padding-inline-start: var(--space-4);
  }
</style>
