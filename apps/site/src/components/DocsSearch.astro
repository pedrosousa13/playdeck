---
/**
 * Search over the documentation, served from a static index and answered in
 * the reader's own browser.
 *
 * Rebuilt on shadcn's `Command` (cmdk) inside a `Dialog` for #542 phase 2 —
 * see `SearchCommand.tsx` for the whole of the behaviour, including why
 * Pagefind, what gets indexed, the two origins `e2e/site-search.spec.ts`
 * exercises this against, and how the keyboard model and the no-off-origin
 * guarantee both survived the rebuild. This file's job is mounting that
 * island where the old component's markup used to sit.
 *
 * `client:load` rather than `client:only`: unlike `ThemeToggleIsland.tsx`
 * (which reads `document.documentElement.dataset.theme` while rendering, and
 * therefore cannot run on the server at all), nothing in `SearchCommand.tsx`
 * touches `document` or `window` outside an effect or an event handler — the
 * dialog starts closed, so nothing Pagefind- or DOM-dependent runs before a
 * reader interacts with it. It is therefore both safe to render on the server
 * (a closed dialog and an inert trigger button, nothing a hydration pass would
 * find to disagree with) and, unlike a lazier directive, hydrated as early as
 * an island here can be.
 *
 * ---- why the shortcut is not in the island ---------------------------------
 *
 * Early is still not immediate. `client:load` hydrates after the document has
 * parsed and the island's own JavaScript has arrived, and a `/` pressed in
 * that gap reaches a document with no listener on it: the keypress is not
 * queued anywhere, it is simply gone, and the next one works. Measured here,
 * a `/` sent as soon as `page.goto` resolved opened nothing, and the same
 * press two seconds later opened the dialog — which is what
 * `e2e/site-search.spec.ts` caught when this component moved from an inline
 * script to a React island, and it is a real regression rather than a test
 * that needed a wait added to it.
 *
 * So the shortcut lives below, inline and unbundled, for the same reason
 * `Base.astro`'s theme script does: it has to be listening before anything
 * asks it to. It owns the whole predicate for what counts as a search-opening
 * keypress, and says so by dispatching one event; the island only listens.
 * That keeps the rule in one place rather than in two that can drift, and it
 * is why `SearchCommand.tsx` has no `keydown` listener of its own.
 *
 * Search is on documentation pages only, which is what `SiteHeader.astro`'s
 * `documentation` prop decides — this component still takes no prop of its
 * own for that, because the caller already knows.
 */
import SearchCommand from './SearchCommand';

const base = import.meta.env.BASE_URL;
---

<SearchCommand client:load base={base} />

<script is:inline>
  /*
   * `/` opens the search dialog, and this listener is attached while the
   * document is still parsing so that a press before the island hydrates is
   * not dropped. See this file's header for the measurement behind that.
   *
   * The island hears one event, `playdeck:search-open`, whenever it should
   * open. A press made before it was listening is held here and dispatched
   * again when it says it is ready, so the early case and the ordinary case
   * arrive the same way rather than the island reading a flag at mount. The
   * replay is queued rather than sent inside the ready handler, so it lands
   * after the mount that asked for it has finished rather than during it.
   *
   * The predicate is deliberately only here. Ignored while the reader is
   * already typing somewhere, or holding a modifier, so `/` in a text field
   * stays a slash and Ctrl+/ stays whatever the browser makes of it. A press
   * while the dialog is open needs no case of its own: focus is in the search
   * field by then, so the typing test below has already returned.
   */
  (() => {
    const open = () => document.dispatchEvent(new CustomEvent('playdeck:search-open'));
    let pending = false;
    let ready = false;

    document.addEventListener('playdeck:search-ready', () => {
      ready = true;
      if (!pending) return;
      pending = false;
      queueMicrotask(open);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== '/') return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement && target.isContentEditable)
      ) {
        return;
      }
      event.preventDefault();
      if (ready) open();
      else pending = true;
    });
  })();
</script>
