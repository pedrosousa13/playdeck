---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroPlayer from '../components/HeroPlayer.astro';
import { measureBundles } from '../../../../scripts/bundle-budgets.mjs';
import { StreamingServicePlayer } from '../../../../examples/archetype-streaming-service';
import { CoursePlatformPlayer } from '../../../../examples/archetype-course-platform';

/**
 * The landing page: the player is the protagonist, not an illustration of one.
 * Rebuilt for #542 after three rejections of the previous shape (a pinned,
 * 300vh "assembly" chapter plus a fixed scrub bar with a timecode) — the
 * maintainer's own words: "this is a huge page that doesn't make sense",
 * "nobody knows wtf a capability ledger is", "I'm throwing the rules out. do
 * something incredible."
 *
 * ---- the shape -------------------------------------------------------------
 *
 * A split hero: the thesis and the install line on one side, the real player
 * (dormant) and its live self-report on the other. Below it, four short
 * sections in plain marketing language: what the truthful controls mean, two
 * real compositions built from the same primitives, the provider count and
 * the measured bundle size, then one line to install. No section number, no
 * scroll cue, no pinned chapter — a reader can leave after the hero and still
 * have the whole argument.
 *
 * ---- two live players, and no more -----------------------------------------
 *
 * The hero (one instance) and the two archetypes. A landing page for a player
 * library that ran more would be arguing that it can run more players, not
 * that its primitives compose.
 *
 * The hero stays `loading="interaction"` and dormant until pressed —
 * `HeroPlayer.astro` carries why the island is `client:only`.
 */

const referenceUrl = `${import.meta.env.BASE_URL}reference/`;
const providersUrl = `${import.meta.env.BASE_URL}providers/`;
const archetypesUrl = `${import.meta.env.BASE_URL}archetypes/`;
const designUrl = `${import.meta.env.BASE_URL}design/`;

// The workbench is deliberately absent, from this page and from the header.
// #534 records the decision that it is not to be a public surface, and the
// maintainer ruled the same on a Storybook link.

const captionsSrc = `${import.meta.env.BASE_URL}archetype-captions.vtt`;

// What both archetypes play HERE. #542's non-negotiables keep this the local
// colour-bar fixture rather than the Blender trailers `/archetypes` plays —
// every request this page can cause has to be same-origin, always, including
// after a press.
const archetypeSource = {
  type: 'video',
  sources: [
    { src: `${import.meta.env.BASE_URL}tracer-45s.mp4`, mimeType: 'video/mp4' }
  ]
} as const;

const streamingMedia = {
  source: archetypeSource,
  kicker: 'Test pattern',
  title: 'Forty-five seconds of colour bars',
  blurb:
    'A fixture served from this origin, not footage. What is on show is the layout around it: this card, the bar over the picture, the marks on the scrubber.',
  credit:
    'The clip is a colour-bar test pattern this site serves itself, a fixture and not a film.'
} as const;

const courseMedia = {
  source: archetypeSource,
  title: 'Forty-five seconds of colour bars',
  note:
    'A fixture served from this origin, not a recording. What is on show is the layout of a study surface: notes beside the picture, a visible speed row, an outline of real buttons rather than ticks on a bar.',
  credit:
    'The clip is a colour-bar test pattern this site serves itself, a fixture and not a lesson.'
} as const;

// The differentiator, in plain words, then the live report from this
// browser rendered beside the hero player. Never "capability ledger": the
// maintainer rejected that phrase outright.
const truths = [
  {
    status: 'available',
    summary: 'Yes. Render the control.',
    detail: 'The command can be issued right now, no caveats attached.'
  },
  {
    status: 'unknown',
    summary: 'Not asked yet.',
    detail:
      'Nothing has been asked of a provider, so a control renders nothing rather than guessing.'
  },
  {
    status: 'unavailable',
    summary: 'No, and here is why.',
    detail:
      'The reason names what refused: the browser, the provider, the policy, or the plan behind the video.'
  }
] as const;

// The two measured figures, from the same module the CI gate fails a build
// with, never hardcoded, so the page and the gate cannot disagree.
const bundles = await measureBundles(import.meta.env.PLAYDECK_REPO_ROOT);
const measured = (name: string) => {
  const bundle = bundles.find((entry) => entry.name === name);
  if (bundle === undefined) {
    throw new Error(`index.astro: ${name} is not a bundle-budgets.mjs target.`);
  }
  return bundle.size;
};
const reactKb = measured('@playdeck/react (primitives, excl. React)');
const coreKb = measured('@playdeck/core');

const install = 'pnpm add @playdeck/react';
---

<Base title="Playdeck: the video player that tells the truth" documentation={false} stance="argument">
  <SiteHeader documentation={false} />

  <main class="page">
    {
      /* ---- hero -----------------------------------------------------------
       *
       * The split: the wordmark, the thesis and the install line on one side;
       * the real player this whole page argues from, dormant, and its own
       * live report on the other. `HeroPlayer` renders both the player and
       * the report out of one island (`.demo` and `.ledger`), which land as
       * the two items of `.hero__stage` below because an `<astro-island>` is
       * `display: contents`.
       */
    }
    <section class="chapter hero" id="hero" data-section="hero">
      <div class="hero__thesis">
        {
          /* Exactly `Playdeck`, and it cannot become anything else.
           * `scripts/check-deploy-artifact.mjs` identifies the site's root
           * document by a heading with that accessible name, and
           * `e2e/site-nav.spec.ts` asserts there is exactly one. */
        }
        <h1 class="wordmark">Playdeck</h1>
        <p class="thesis">
          The video player that tells the truth. Headless primitives, five
          providers, and zero requests until you press play.
        </p>

        <div class="cta">
          <div class="install" data-install>
            <code class="install__command" data-install-command>{install}</code>
            <button class="install__copy" type="button" hidden data-install-copy>
              Copy
            </button>
            <span class="u-visually-hidden" role="status" data-install-status
            ></span>
          </div>
          <a class="cta__secondary" href={referenceUrl}>Reference &rarr;</a>
        </div>
      </div>

      <div class="hero__stage">
        <HeroPlayer />
      </div>
    </section>

    {
      /* ---- truth ------------------------------------------------------------
       *
       * The differentiator, in plain words. Never "capability ledger": the
       * maintainer rejected the phrase outright. */
    }
    <section class="chapter truth" id="truth" data-section="truth">
      <h2 class="chapter__title">No greyed-out buttons. Ever.</h2>
      <p class="truth__lede">
        A control the player can't honour isn't disabled. It's gone, and you
        get the reason. The player above answers for exactly the browser
        you're reading this in.
      </p>
      <ul class="truths">
        {
          truths.map(({ status, summary, detail }) => (
            <li class="truth-card u-enter" data-status={status}>
              <h3 class="truth-card__name">
                <span class="truth-card__dot" aria-hidden="true" />
                {status}
              </h3>
              <p class="truth-card__summary">{summary}</p>
              <p class="truth-card__detail">{detail}</p>
            </li>
          ))
        }
      </ul>

      {
        /* The live report, as supporting evidence under the plain-language
         * claim above rather than as the hero's second thing to look at. The
         * panel itself is `Ledger` in `HeroPlayerIsland.tsx`, mounted at the
         * hero and portaled here — see that file for why a portal and not a
         * second instance. This element is only ever the portal's target: it
         * renders nothing of its own, and with JavaScript blocked it stays
         * empty, exactly as `.demo`'s own player does. */
      }
      <div class="truth__evidence" id="truth-ledger-mount" />
    </section>

    {
      /* ---- faces --------------------------------------------------------
       *
       * Both archetypes, live, from the same primitives. `client:visible` on
       * both, so a reader who never scrolls here never pays for either. */
    }
    <section class="chapter faces" id="faces" data-section="faces">
      <h2 class="chapter__title">Same parts. Any face.</h2>
      <p class="faces__lede">
        A streaming service and a course platform, visually unrelated, built
        live on this page from one set of primitives. The stylesheet is the
        only difference, and it's yours.
      </p>
      <p class="disclosure">
        Both players below are mounted when you scroll to them, so their
        JavaScript arrives at that moment. Neither fetches a clip nor attaches
        a provider until you press it, and everything either can fetch is
        served from this origin.
      </p>

      <div class="faces__grid">
        <figure class="archetype">
          <div class="stage">
            <StreamingServicePlayer
              captionsSrc={captionsSrc}
              client:visible
              media={streamingMedia}
              resumeAt={18}
            />
          </div>
          <figcaption class="archetype__caption">
            A streaming service: the picture owns the frame, chapters are
            marks on the scrubber. No quality menu, the native provider
            cannot switch renditions of a progressive file, so
            {' '}<code>selectQuality</code> answers <code>unavailable</code>{' '}
            and nothing draws a ladder that does not exist.
          </figcaption>
        </figure>

        <figure class="archetype">
          <div class="stage">
            <CoursePlatformPlayer
              captionsSrc={captionsSrc}
              client:visible
              media={courseMedia}
              resumeAt={14}
            />
          </div>
          <figcaption class="archetype__caption">
            A course platform: the video shares the page with the lesson
            instead of owning it, speed is a visible row, and navigation is
            an outline of real buttons rather than ticks on a bar.
          </figcaption>
        </figure>
      </div>
      <p class="faces__licence">
        Read both files &rarr;
        {' '}
        <a href={archetypesUrl}>the archetypes page</a> prints each source
        beside the player it builds, and plays the Blender Foundation open
        movie trailers they ship pointed at, &copy; Blender Foundation and
        licensed
        {' '}
        <a href="https://creativecommons.org/licenses/by/3.0/" rel="license">
          CC BY 3.0
        </a>.
      </p>
    </section>

    {
      /* ---- remote --------------------------------------------------------- */
    }
    <section class="chapter remote" id="remote" data-section="remote">
      <h2 class="chapter__title">One remote. Five providers.</h2>
      <p class="remote__strip">MP4 &middot; HLS &middot; YouTube &middot; Vimeo &middot; Wistia</p>
      <p class="remote__lede">
        Adapters load lazily, so a page playing MP4 ships none of the others.
      </p>
      <dl class="remote__figures">
        <div class="remote__figure">
          <dt>@playdeck/react</dt>
          <dd>{reactKb.toFixed(0)}<span class="remote__unit"> KB</span></dd>
        </div>
        <div class="remote__figure">
          <dt>@playdeck/core</dt>
          <dd>{coreKb.toFixed(0)}<span class="remote__unit"> KB</span></dd>
        </div>
      </dl>
      <p class="remote__note">
        gzipped, both. Measured by the same script CI gates the build with,
        {' '}<a href={providersUrl}>every provider is printed on its own page</a>.
      </p>
    </section>

    {
      /* ---- credits ------------------------------------------------------
       *
       * End-credits treatment: dark stage, centred, one huge install command.
       */
    }
    <section class="chapter credits" id="credits" data-section="credits">
      <p class="credits__roll">
        <span>directed by <strong>you</strong></span>
        <span>starring <strong>your components</strong></span>
        <span>no CSS was shipped in the making of this player</span>
      </p>
      <h2 class="chapter__title credits__title">Start with one line.</h2>
      <div class="cta credits__cta">
        <div class="install" data-install>
          <code class="install__command" data-install-command>{install}</code>
          <button class="install__copy" type="button" hidden data-install-copy>
            Copy
          </button>
          <span class="u-visually-hidden" role="status" data-install-status
          ></span>
        </div>
      </div>
      <p class="credits__links">
        <a href={referenceUrl}>Reference &rarr;</a>
        <a href={providersUrl}>Providers &rarr;</a>
        <a href={archetypesUrl}>Archetypes &rarr;</a>
      </p>
      <p class="credits__fineprint">
        React 19 as a peer dependency &middot; ESM only &middot; named exports
        {' '}&middot;{' '}
        <a href={designUrl}>the visual system</a> that lists every colour,
        face and size this page spent.
      </p>
    </section>
  </main>
</Base>

<script>
  /**
   * Two independent pieces of behaviour, neither of which the page needs to
   * run at all: the entry motion, and the two install buttons. Both degrade
   * to a settled, readable page on their own — see each block for how.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- entry motion, the site-wide vocabulary -----------------------------
  //
  // `.u-enter` unchanged from the page this replaces — `base.css` carries the
  // full reasoning. Kept here rather than moved, because this page is still
  // the one `[data-stance='argument']` document that spends it.
  if (!reduced.matches) {
    const reveal = (selector: string, attribute: string) => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.removeAttribute(attribute);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '10000px 0px -10% 0px' }
      );

      for (const target of document.querySelectorAll(selector)) {
        if (target.getBoundingClientRect().top < window.innerHeight) continue;
        target.setAttribute(attribute, '');
        observer.observe(target);
      }
    };

    reveal('.u-enter', 'data-enter');
  }

  // ---- the install line's copy button, on both of its instances ----------
  const COPIED_MS = 2000;

  for (const group of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const command = group.querySelector<HTMLElement>('[data-install-command]');
    const button = group.querySelector<HTMLButtonElement>('[data-install-copy]');
    const status = group.querySelector<HTMLElement>('[data-install-status]');
    if (command === null || button === null || status === null) continue;

    if (!navigator.clipboard) continue;

    const idle = button.textContent ?? 'Copy';
    let restore: ReturnType<typeof setTimeout> | undefined;

    button.hidden = false;
    button.addEventListener('click', () => {
      const text = (command.textContent ?? '').trim();
      void navigator.clipboard.writeText(text).then(
        () => {
          button.textContent = 'Copied';
          status.textContent = `Copied ${text} to the clipboard.`;
        },
        () => {
          button.textContent = 'Press to select';
          status.textContent =
            'The clipboard refused. Select the command to copy it.';
          const range = document.createRange();
          range.selectNodeContents(command);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      );

      clearTimeout(restore);
      restore = setTimeout(() => {
        button.textContent = idle;
        status.textContent = '';
      }, COPIED_MS);
    });
  }
</script>

<style>
  .page {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }

  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-block-start: var(--space-9);
    max-inline-size: 100%;
  }

  .chapter__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .disclosure {
    max-inline-size: var(--measure);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--line-width) solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* ---- hero, an asymmetric split: thesis on one side, the running player on
   * the other. Stacked below 64rem, thesis first — a reader on a phone reads
   * the claim before they reach the instrument.
   *
   * The live report used to sit under the player in this same column, which
   * made the thesis column roughly half the height of the stage column: at
   * `align-items: center` that put ~440px of dead air above the thesis text.
   * The report now lives in the `truth` section below (see `Ledger` /
   * `LedgerPortal` in `HeroPlayerIsland.tsx`), so the stage column is the
   * player alone and the two columns are close enough in height for
   * `align-items: center` to read as a deliberate pairing rather than a
   * layout accident. */
  .hero {
    align-items: start;
    gap: var(--space-7);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-2);
  }

  .hero__thesis {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .hero {
      /* The player is the protagonist: its column carries more of the row's
       * width than the thesis column does, rather than the near-even split
       * this used to be. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      column-gap: var(--space-8);
      align-items: center;
    }
  }

  .hero__stage {
    display: grid;
    gap: var(--space-5);
    min-inline-size: 0;
  }

  /* The wordmark: display type, solid ink, nothing clipped or filled. A
   * gradient text-fill used to stand here; on screen it read as a rainbow
   * rather than a brand mark, so the weight this word carries now comes from
   * scale, weight and spacing alone — the same three levers every other
   * heading on this page uses. Sized to a headline that reads as one word
   * rather than a poster: a hero holding a live player beside it has no room
   * left for an 11rem letterform. */
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .thesis {
    max-inline-size: var(--measure);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    color: var(--color-ink-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    min-block-size: var(--hit-target);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-sunken);
    border-radius: var(--radius-md);
  }

  .install__command {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .install__copy {
    flex: none;
    min-block-size: var(--space-6);
    padding-inline: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
    background-color: transparent;
    border: var(--line-width) solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .install__copy:hover {
    color: var(--color-ink);
  }

  .install__copy:active {
    color: var(--color-ink-subtle);
    border-color: var(--color-accent);
  }

  .cta__secondary {
    font-size: var(--text-md);
  }

  @media (scripting: none) {
    .hero__stage :global(noscript) {
      display: contents;
    }
  }

  /* Restores the no-theme activation geometry: this page also mounts
   * `@playdeck/react/theme.css` (`HeroPlayer.astro` imports it), whose
   * activation part is sized 4rem square, and the two labelled pills on
   * these title cards become squares with their labels spilling out
   * without this. `e2e/site-landing.spec.ts` pinned the defect. */
  .stage :global([data-playdeck-part='activation']) {
    inline-size: auto;
    block-size: auto;
  }

  /* ---- truth ------------------------------------------------------------ */
  .truth__lede {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .truths {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .truths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The portal target for `Ledger`. Narrower than the three-card row above
   * it and centred, so the live report reads as one piece of evidence
   * offered under the claim rather than a fourth card competing with the
   * three that state it. Empty whenever the island has not portaled into it
   * yet, which with no JavaScript is always, so it costs no space of its own
   * until there is something to show. */
  .truth__evidence {
    max-inline-size: 34rem;
    margin-block-start: var(--space-6);
    margin-inline: auto;
  }

  .truth-card {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: var(--line-width) solid var(--color-line);
  }

  .truth-card__name {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    color: var(--status-color);
    letter-spacing: var(--tracking-fn);
  }

  .truth-card__dot {
    align-self: center;
    flex: none;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background-color: var(--status-color);
    border-radius: var(--radius-pill);
  }

  .truth-card__summary {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .truth-card__detail {
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  /* ---- faces -------------------------------------------------------------- */
  .faces__lede {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .faces__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    min-inline-size: 0;
  }

  @media (min-width: 64rem) {
    .faces__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .archetype {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    min-inline-size: 0;
    margin: 0;
  }

  .archetype__caption {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .faces__licence {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
  }

  /* ---- remote ------------------------------------------------------------ */
  .remote__strip {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: var(--tracking-fn);
    color: var(--color-ink);
  }

  .remote__lede {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .remote__figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin: 0;
  }

  .remote__figure dt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
    letter-spacing: var(--tracking-fn);
  }

  .remote__figure dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .remote__unit {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    color: var(--color-ink-muted);
  }

  .remote__note {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
  }

  /* ---- credits -------------------------------------------------------------
   *
   * Always dark, like the player and its report. */
  .credits {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
