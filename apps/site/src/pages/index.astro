---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Bench from '../components/Bench.astro';
import { measureBundles } from '../../../../scripts/bundle-budgets.mjs';

/**
 * The landing page, as one instrument.
 *
 * It has been rebuilt six times. The version this replaces was six sections
 * down one column, each a claim in a heading followed by the code that backed
 * it — correct, honest, and dead. Every section had the same shape, nothing on
 * the page was larger than anything else, and the only element that was
 * actually alive appeared once in the hero and never came back. A library whose
 * whole argument is about behaviour was arguing in paragraphs.
 *
 * ---- the shape --------------------------------------------------------------
 *
 * Thesis, the player, the switches, what they built, the close. Composability
 * and customisability — the two features this page still sells — are each
 * delivered by operating the bench rather than by reading about them: the
 * source switch is a real prop change to a real player, and the skin switch
 * is a real stylesheet added and removed. There is no section per feature,
 * because the page is one instrument with knobs where the old page was six
 * things with none.
 *
 * Capability querying and autoplay recovery used to round the four out to a
 * quartet, and neither is sold here any more. Autoplay recovery went first —
 * `bench-composition.ts` carries why, and it comes down to `loading="interaction"`
 * making the refusal this page would have demonstrated unreachable. Capability
 * querying went last, and further than either of the two panels that preceded
 * it: not to one line, but to nothing. See `DESIGN.md`'s capability-argument
 * section for the full history and why a fourth cut rather than a fourth
 * shrink was the maintainer's call.
 *
 * ---- what does not appear ---------------------------------------------------
 *
 * No capability table, grid, list of statuses or one-line report. All four
 * were designed, in that order, and all four were cut — the ruling for each is
 * recorded in `DESIGN.md`, because each was attractive enough to be
 * reinvented.
 *
 * No claim about any other library, named or implied. An earlier draft opened
 * with "every video player ships a design", which is false, and the maintainer
 * ruled the whole category out.
 *
 * No archetype. Those two belong on `/archetypes`, which is the page whose
 * subject they are, and they came off `/` in `b348879` for being too much on a
 * marketing page. Putting them back behind a switch would still be putting them
 * back.
 */

const startUrl = `${import.meta.env.BASE_URL}start/`;
const referenceUrl = `${import.meta.env.BASE_URL}reference/`;
const providersUrl = `${import.meta.env.BASE_URL}providers/`;
const archetypesUrl = `${import.meta.env.BASE_URL}archetypes/`;

/*
 * The measured figure and the budget it is measured against, both read from the
 * module `pnpm test:budgets` gates with, so the page and the gate cannot state
 * different numbers. Neither is typed here: a second copy would let the page
 * and the gate disagree while both stayed green, which is the one failure a
 * page making this argument cannot survive.
 */
const bundles = await measureBundles(import.meta.env.PLAYDECK_REPO_ROOT);
const primitives = bundles.find(
  (entry) => entry.name === '@playdeck/react (primitives, excl. React)'
);
if (primitives === undefined || primitives.budget === null) {
  throw new Error(
    'index.astro: the primitives bundle is not a budgeted bundle-budgets.mjs target.'
  );
}

/*
 * What one provider adapter costs, measured rather than written, so the close
 * cannot claim a figure the packages have moved away from. YouTube because it
 * is the switch's default and so the one a reader is most likely to reach for.
 */
const youtube = bundles.find(
  (entry) => entry.name === '@playdeck/provider-youtube'
);
if (youtube === undefined) {
  throw new Error(
    'index.astro: the YouTube provider is not a bundle-budgets.mjs target.'
  );
}

/*
 * The close's four cells. Two are measurements and two are claims, and the
 * mix is deliberate rather than a grid that decayed.
 *
 * Two used to be numbers that could not have been anything else. `0` — "CSS in
 * the bundle" — was a definitional fact dressed as a measurement. `1 of 5` was
 * worse: it read as a rating, and the maintainer said outright they could not
 * tell what it meant. Neither was telling a reader something they had to be
 * shown, which is the job the other two do.
 *
 * What replaces them says the same facts from the consumer's side rather than
 * the bundle's. The provider cell keeps a real number inside its sentence,
 * because "what does adding YouTube cost me" is the question a reader actually
 * has, and that number is read from `measureBundles` like the first figure
 * rather than typed.
 */
const figures = [
  {
    value: `${primitives.size.toFixed(0)} kB`,
    line: `Every primitive, gzipped. CI fails the build at ${primitives.budget}.`
  },
  {
    value: 'One adapter, not five',
    line: `Every provider is its own package. Adding YouTube costs ${youtube.size.toFixed(0)} kB; the other four never reach your bundle.`
  },
  {
    value: '0',
    line: 'Requests to a provider before someone presses play.'
  },
  {
    value: 'Unstyled by default',
    line: 'Every pixel on screen is a decision you made, not one you undid.'
  }
];

const install = 'pnpm add @playdeck/react';
---

<Base
  title="Playdeck: a video player you compose"
  documentation={false}
  stance="argument"
>
  <SiteHeader documentation={false} />

  <main class="page">
    <section class="thesis">
      {
        /* Exactly `Playdeck`, and it cannot become anything else.
         * `scripts/check-deploy-artifact.mjs` identifies the site's root
         * document by a heading with that accessible name, and
         * `e2e/site-nav.spec.ts` asserts there is exactly one.
         *
         * It sets small, because it names the document rather than arguing.
         * The display rung goes to the sentence under it — `DESIGN.md`'s Type
         * section carries that amendment and its reasoning. */
      }
      <h1 class="thesis__name">Playdeck</h1>
      <p class="thesis__display">
        A video player you compose, not one you configure.
      </p>
      <p class="thesis__lede">
        React primitives and hooks over native video, HLS, YouTube, Vimeo and
        Wistia. You write the markup, you write the CSS, and the same six lines
        drive all five.
      </p>
    </section>

    <Bench />

    {
      /* The close: four figures, the command, and the ways onward. A reader who
       * leaves before this has already had the whole argument, which is the
       * test every part of this page has to pass, so the close takes no
       * treatment of its own. */
    }
    <section class="close">
      <dl class="figures">
        {
          figures.map(({ value, line }) => (
            <div class="figure">
              <dt class="figure__value">{value}</dt>
              <dd class="figure__line">{line}</dd>
            </div>
          ))
        }
      </dl>

      {
        /* The command is selectable text; the copy button is `hidden` in the
         * markup and revealed by the script below. Writing to the clipboard is
         * the whole of what the control does, so with no script there is
         * nothing to press rather than a control that swallows a click, and
         * nothing is lost — the command was never behind the button. The
         * feedback is a text swap on the button with the same words said once
         * through a `role="status"` line. */
      }
      <div class="install" data-install>
        <code class="install__command" data-install-command>{install}</code>
        <button class="install__copy" type="button" hidden data-install-copy>
          Copy
        </button>
        <span class="u-visually-hidden" role="status" data-install-status></span>
      </div>

      <p class="close__fineprint">React 19 peer, ESM only, named exports</p>

      {
        /* Start leads, and it is the only one of these that is a route rather
         * than a section: the command above tells a reader what to install and
         * nothing about what to write next, which is the gap #547 exists to
         * close. What follows it is unchanged. */
      }
      <p class="close__links">
        <a href={startUrl}>Start &rarr;</a>
        <a href={referenceUrl}>Reference &rarr;</a>
        <a href={providersUrl}>Providers &rarr;</a>
        <a href={archetypesUrl}>Archetypes &rarr;</a>
      </p>
    </section>
  </main>
</Base>

<script>
  /**
   * The install line's copy button, and nothing else. The page needs no script
   * to be readable: this reveals a control that does one thing, and its absence
   * costs a reader the convenience rather than the command.
   */
  const COPIED_MS = 2000;

  for (const group of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const command = group.querySelector<HTMLElement>('[data-install-command]');
    const button = group.querySelector<HTMLButtonElement>('[data-install-copy]');
    const status = group.querySelector<HTMLElement>('[data-install-status]');
    if (command === null || button === null || status === null) continue;

    if (!navigator.clipboard) continue;

    const idle = button.textContent ?? 'Copy';
    let restore: ReturnType<typeof setTimeout> | undefined;

    button.hidden = false;
    button.addEventListener('click', () => {
      const text = (command.textContent ?? '').trim();
      void navigator.clipboard.writeText(text).then(
        () => {
          button.textContent = 'Copied';
          status.textContent = `Copied ${text} to the clipboard.`;
        },
        () => {
          button.textContent = 'Press to select';
          status.textContent =
            'The clipboard refused. Select the command to copy it.';
          const range = document.createRange();
          range.selectNodeContents(command);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      );

      clearTimeout(restore);
      restore = setTimeout(() => {
        button.textContent = idle;
        status.textContent = '';
      }, COPIED_MS);
    });
  }
</script>

<style>
  .page {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }

  /* ---- the thesis ---------------------------------------------------------- */
  .thesis {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-7);
    justify-items: start;
  }

  /* The document's name, not its argument. `h3`'s rung, in the muted ink, so
   * the sentence below it is unmistakably the larger of the two. */
  .thesis__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-muted);
  }

  /* The display rung, spent on the sentence that argues rather than on the
   * heading that names. A step between two rungs of the scale rather than a
   * `clamp()`, because a clamp is a font size written into a component and no
   * component here writes one: 88px would take three quarters of a phone's
   * width and cost the lead its first screen. */
  .thesis__display {
    max-inline-size: 26ch;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  @media (min-width: 48rem) {
    .thesis__display {
      font-size: var(--text-4xl);
    }
  }

  .thesis__lede {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  /* ---- the close ----------------------------------------------------------- */
  .close {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: var(--line-width) solid var(--color-line-strong);
    justify-items: start;
  }

  /* Four figures across where there is width for them, and stacked where there
   * is not. Each is one number and one sentence: the number is the claim and
   * the sentence is what makes it checkable. */
  .figures {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    inline-size: 100%;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figure {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-block-start: var(--space-3);
    border-block-start: var(--line-width) solid var(--color-line);
  }

  .figure__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
  }

  .figure__line {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* The one element in this section that is centred rather than set against
   * the left edge. `.close` lays its children out with `justify-items: start`,
   * so this pill is already shrink-to-fit and only its placement in the track
   * has to move — `justify-self` on the item, not a change to the container,
   * because every sibling here keeps the start edge the section reads down.
   *
   * `justify-content` inside it as well, for the case the box is wider than
   * its contents: the command and its copy button stay together in the middle
   * rather than the command sitting alone at the left of a centred box. */
  .install {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    justify-self: center;
    min-block-size: var(--hit-target);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-sunken);
    border-radius: var(--radius-md);
  }

  .install__command {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .install__copy {
    flex: none;
    min-block-size: var(--space-6);
    padding-inline: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
    background-color: transparent;
    border: var(--line-width) solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .install__copy:hover {
    color: var(--color-ink);
  }

  .install__copy:active {
    color: var(--color-ink-subtle);
    border-color: var(--color-accent);
  }

  .close__fineprint {
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-subtle);
  }

  .close__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    font-size: var(--text-md);
  }
</style>
