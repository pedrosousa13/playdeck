---
import Base from '../layouts/Base.astro';

// The link is not decoration. It is the one link the site needs anyway — the
// workbench, which `scripts/assemble-deploy.mjs` places under `storybook/` beside
// this page — and it is also what `scripts/check-deploy-artifact.mjs` follows
// from here in a browser, which is how the two surfaces are proven to be
// reachable from each other rather than merely present in the same directory.
//
// Written through `import.meta.env.BASE_URL`, which is what Astro fills the
// configured `base` into, rather than as a literal. That prefix is the root
// today and the literal would be identical, which is precisely why the habit is
// worth keeping here: the day the site moves under a prefix, a hand-written
// `/storybook/` is the bug a base path exists to prevent (#435) and nothing
// would flag it.
const storybookUrl = `${import.meta.env.BASE_URL}storybook/`;

// The specimen sheet, addressed the same way and for the same reason. It is a
// design reference rather than a destination for a reader of the site, which is
// why it is one line at the bottom of a placeholder and not navigation.
const designUrl = `${import.meta.env.BASE_URL}design/`;

// The package reference, addressed the same way and for the same reason (#523).
const referenceUrl = `${import.meta.env.BASE_URL}reference/`;
---

{
  /* Rendered through `Base.astro` so the placeholder gets the stylesheet, the
   * self-hosted faces and the pre-paint theme script that every page of this
   * site is served with. A page holding its own `<html>` would look right until
   * the moment the theme it painted was the wrong one. */
}
<Base title="Playdeck">
  <h1>Playdeck</h1>
  <p><a href={designUrl}>Visual system reference</a></p>
  {
    /* Before the workbench link, and that is the whole reason it is here rather
     * than under it: the note below explains why nothing may follow the
     * workbench, so anything the site gains goes above it. */
  }
  <p><a href={referenceUrl}>Package reference</a></p>
  {
    /* The workbench comes last, and the order is load-bearing:
     * `scripts/check-deploy-artifact.mjs` follows every internal link on this
     * page in document order, and the workbench goes on fetching its own
     * scripts well after its document has arrived. Following another link
     * after it abandons those requests, and an abandoned request is exactly
     * what that check reports — it cannot tell a navigation that dropped one
     * from a wrong prefix that never had it. */
  }
  <p><a href={storybookUrl}>Storybook workbench</a></p>
</Base>
