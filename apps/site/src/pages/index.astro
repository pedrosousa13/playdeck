---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroPlayer from '../components/HeroPlayer.astro';
import { shikiConfig } from '../shiki';
import { measureBundles } from '../../../../scripts/bundle-budgets.mjs';

/**
 * The landing page: the player is the protagonist, not an illustration of one.
 * Rebuilt for #542 after three rejections of the previous shape (a pinned,
 * 300vh "assembly" chapter plus a fixed scrub bar with a timecode) — the
 * maintainer's own words: "this is a huge page that doesn't make sense",
 * "nobody knows wtf a capability ledger is", "I'm throwing the rules out. do
 * something incredible."
 *
 * ---- the shape -------------------------------------------------------------
 *
 * A split hero, then one section per feature, then the close. The reader is a
 * React engineer choosing a video library, and what they buy on is the API, so
 * every feature is a claim and then the code that does it: querying what a
 * player can do, autoplay that recovers from a policy block and reports it,
 * composing two products from one set of primitives, and owning the markup.
 *
 * ---- one player on this page ------------------------------------------------
 *
 * The hero's, and nothing else. Two full archetypes ran here for two of this
 * page's lives and they were by a wide margin the largest thing on it: two
 * running products, four hundred lines of composition, their own stylesheets,
 * their own clip, a poster, a scroll-mount disclosure and a licence paragraph,
 * all in the middle of an argument about an API. The maintainer's objection was
 * that too much was going on, and they were most of it.
 *
 * So composition is now argued the way the three features around it are, in the
 * code that does it, and the running proof lives on `/archetypes` — the page
 * whose subject those two files are, which prints each one's whole source
 * beside the player it builds. That is a better home for them than a section of
 * a landing page, and it is where a reader who wants them will already look.
 *
 * What left with them: `tracer-45s.mp4` and its poster (nothing else served
 * either), the `client:visible` mounts, the scroll-loading disclosure, and the
 * `.stage` override that existed only to undo the player theme's activation
 * sizing on those two compositions.
 *
 * The hero stays `loading="interaction"` and dormant until pressed —
 * `HeroPlayer.astro` carries why the island is `client:only`.
 */

const referenceUrl = `${import.meta.env.BASE_URL}reference/`;
const providersUrl = `${import.meta.env.BASE_URL}providers/`;
const archetypesUrl = `${import.meta.env.BASE_URL}archetypes/`;
const designUrl = `${import.meta.env.BASE_URL}design/`;

// The workbench is deliberately absent, from this page and from the header.
// #534 records the decision that it is not to be a public surface, and the
// maintainer ruled the same on a Storybook link.

/*
 * The four features this page is here to sell, in the order a React engineer
 * meets them when they try the library, and each one shown as the code that
 * uses it rather than described.
 *
 * The snippets are written here rather than read out of a file, which is the
 * one place this page departs from the rule the archetypes below follow. They
 * are not examples that compile: each is the three or four lines of a real API
 * that make one point, with the rest of a working component left out. What
 * keeps them honest is that every identifier in them exists —
 * `state.capabilities`, `state.autoplayRecovered`, `usePlayerActions`,
 * `autoplay="audible-then-muted"` — and `pnpm typecheck` covers the files that
 * do compile, on `/archetypes` and in the package READMEs.
 */

// The three answers a capability gives, in plain words, beside the live report
// from this browser. Never "capability ledger": the maintainer rejected that
// phrase outright.
const truths = [
  {
    status: 'available',
    summary: 'Yes. Render the control.',
    detail: 'The command can be issued right now, no caveats attached.'
  },
  {
    status: 'unknown',
    summary: 'Not asked yet.',
    detail:
      'Nothing has been asked of a provider, so a control renders nothing rather than guessing.'
  },
  {
    status: 'unavailable',
    summary: 'No, and here is why.',
    detail:
      'The reason names what refused: the browser, the provider, the policy, or the plan behind the video.'
  }
] as const;

const capabilitiesSnippet = `const quality = Player.usePlayerState(
  (state) => state.capabilities.selectQuality
);

// Not disabled. Absent, and the reason is on the object.
if (quality.status !== 'available') return null;

return <QualityMenu />;`;

const autoplaySnippet = `<Player.Root source={source} autoplay="audible-then-muted">
  <UnmuteNudge />
</Player.Root>;

const UnmuteNudge = () => {
  // True only where the audible attempt was refused by policy and the
  // muted retry is what played. Never true for a muted autoplay you asked
  // for, so this offer appears exactly when the viewer lost sound.
  const recovered = Player.usePlayerState((s) => s.autoplayRecovered);
  const actions = Player.usePlayerActions();
  if (!recovered) return null;

  return <button onClick={() => void actions.unmute()}>Sound off. Turn on</button>;
};`;

const composeSnippet = `// A streaming service. The chrome sits over the picture.
<Player.Viewport className="cinema">
  <Player.Media />
  <Player.Controls />
</Player.Viewport>;

// A course platform. The picture shares the page, and nothing
// covers what is being read.
<div className="study">
  <Player.Viewport>
    <Player.Media />
  </Player.Viewport>
  <Player.Controls />
  <LessonOutline />
</div>;`;

const customSnippet = `<Player.Root source={source}>
  <Player.Viewport className="yours">
    <Player.Media />
    <Player.Captions />
  </Player.Viewport>

  {/* Your markup, your classes, your layout. These carry
      behaviour and ARIA, and no CSS at all. */}
  <div className="also-yours">
    <Player.PlayButton />
    <Player.SeekSlider />
    <Player.Time />
  </div>
</Player.Root>;`;

// The two measured figures, from the same module the CI gate fails a build
// with, never hardcoded, so the page and the gate cannot disagree.
const bundles = await measureBundles(import.meta.env.PLAYDECK_REPO_ROOT);
const measured = (name: string) => {
  const bundle = bundles.find((entry) => entry.name === name);
  if (bundle === undefined) {
    throw new Error(`index.astro: ${name} is not a bundle-budgets.mjs target.`);
  }
  return bundle.size;
};
const reactKb = measured('@playdeck/react (primitives, excl. React)');
const coreKb = measured('@playdeck/core');

const install = 'pnpm add @playdeck/react';
---

<Base title="Playdeck: the video player that tells the truth" documentation={false} stance="argument">
  <SiteHeader documentation={false} />

  <main class="page">
    {
      /* ---- hero -----------------------------------------------------------
       *
       * The split: the wordmark, the thesis and the install line on one side;
       * the real player this whole page argues from, dormant, and its own
       * live report on the other. `HeroPlayer` renders both the player and
       * the report out of one island (`.demo` and `.ledger`), which land as
       * the two items of `.hero__stage` below because an `<astro-island>` is
       * `display: contents`.
       */
    }
    <section class="chapter hero" id="hero" data-section="hero">
      <div class="hero__thesis">
        {
          /* Exactly `Playdeck`, and it cannot become anything else.
           * `scripts/check-deploy-artifact.mjs` identifies the site's root
           * document by a heading with that accessible name, and
           * `e2e/site-nav.spec.ts` asserts there is exactly one. */
        }
        <h1 class="wordmark">Playdeck</h1>
        <p class="thesis">
          The video player that tells the truth. Headless primitives, five
          providers, and no video request until you press play.
        </p>

        <p class="hero__providers">
          <span>MP4</span><span>HLS</span><span>YouTube</span><span>Vimeo</span
          ><span>Wistia</span>
        </p>

        <div class="cta">
          <div class="install" data-install>
            <code class="install__command" data-install-command>{install}</code>
            <button class="install__copy" type="button" hidden data-install-copy>
              Copy
            </button>
            <span class="u-visually-hidden" role="status" data-install-status
            ></span>
          </div>
          <a class="cta__secondary" href={referenceUrl}>Reference &rarr;</a>
        </div>
      </div>

      <div class="hero__stage">
        <HeroPlayer />
      </div>
    </section>

    {
      /* ---- capabilities: feature one ---------------------------------------
       *
       * The differentiator, told as the feature it is. Never "capability
       * ledger": the maintainer rejected the phrase outright, and
       * `site-landing.spec.ts` asserts it appears nowhere. */
    }
    <section
      class="chapter feature"
      id="capabilities"
      data-section="capabilities"
    >
      <div class="feature__head">
        <h2 class="chapter__title">Ask the player what it can do.</h2>
        <p class="feature__lede">
          Every command carries an availability. Read it, and render the
          control only where it means something. No greyed-out buttons, ever,
          because there is nothing to grey out.
        </p>
      </div>

      <div class="feature__body">
        <div class="code">
          <Code code={capabilitiesSnippet} lang="tsx" {...shikiConfig} />
        </div>

        <ul class="truths">
          {
            truths.map(({ status, summary, detail }) => (
              <li class="truth-card u-enter" data-status={status}>
                <h3 class="truth-card__name">
                  <span class="truth-card__dot" aria-hidden="true" />
                  {status}
                </h3>
                <p class="truth-card__summary">{summary}</p>
                <p class="truth-card__detail">{detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="feature__note">
        Eleven of them, on <code>state.capabilities</code>: seeking, volume,
        rate, quality, text tracks, chapters, fullscreen, picture in picture,
        AirPlay and the rest. Below is the real answer for the browser you are
        reading this in, from the player above.
      </p>

      {
        /* The live report. The panel is `Ledger` in `HeroPlayerIsland.tsx`,
         * mounted at the hero and portaled here — see that file for why a
         * portal and not a second instance. This element is only ever the
         * portal's target: it renders nothing of its own, and with JavaScript
         * blocked it stays empty, exactly as the hero's own player does. */
      }
      <div class="feature__evidence" id="truth-ledger-mount"></div>
    </section>

    {
      /* ---- autoplay: feature two -------------------------------------------
       *
       * Not on the page before this pass, and the one feature here a reader
       * cannot see by looking at a running player, so it is told entirely in
       * the API and in what the browser does. */
    }
    <section class="chapter feature" id="autoplay" data-section="autoplay">
      <div class="feature__head">
        <h2 class="chapter__title">Autoplay that recovers, and says so.</h2>
        <p class="feature__lede">
          Ask for sound. When the browser refuses, the player mutes and tries
          once more, then tells you that is what happened so you can offer the
          viewer their sound back.
        </p>
      </div>

      <div class="code code--wide">
        <Code code={autoplaySnippet} lang="tsx" {...shikiConfig} />
      </div>

      <ol class="steps">
        <li class="step">
          <p class="step__state"><code>attempting</code></p>
          <p class="step__detail">
            The audible attempt goes out, exactly as you asked for it.
          </p>
        </li>
        <li class="step">
          <p class="step__state"><code>blocked</code></p>
          <p class="step__detail">
            Policy refuses it. Only a refusal retries: any other failure is
            reported as it is, unretried.
          </p>
        </li>
        <li class="step">
          <p class="step__state"><code>started</code></p>
          <p class="step__detail">
            The muted retry plays, and
            {' '}<code>autoplayRecovered</code> turns true. It is false for a
            muted autoplay you asked for, so the two never look alike.
          </p>
        </li>
        <li class="step">
          <p class="step__state"><code>suppressed</code></p>
          <p class="step__detail">
            A viewer on
            {' '}<code>prefers-reduced-motion: reduce</code> is not autoplayed
            at, and that is a state of its own rather than silence.
          </p>
        </li>
      </ol>
    </section>

    {
      /* ---- compose: feature three ------------------------------------------
       *
       * Told in code, like the three features around it, and not by mounting
       * two whole products in the middle of the page. Both archetypes ran here
       * for two of this page's lives; they were the largest thing on it by a
       * wide margin and the maintainer's objection was that too much was going
       * on. They still run, on `/archetypes`, which is the page whose subject
       * they are. */
    }
    <section class="chapter feature" id="compose" data-section="compose">
      <div class="feature__head">
        <h2 class="chapter__title">Two products. One set of primitives.</h2>
        <p class="feature__lede">
          The primitives do not decide what your player looks like or where its
          parts go. Move them, and the same three components are a different
          product.
        </p>
      </div>

      <div class="code code--wide">
        <Code code={composeSnippet} lang="tsx" {...shikiConfig} />
      </div>

      <p class="feature__note">
        Both of those are real and both run, side by side and playing, on
        {' '}<a href={archetypesUrl}>the archetypes page</a>, which prints each
        one's whole source beside the player it builds.
      </p>
    </section>

    {
      /* ---- custom: feature four --------------------------------------------- */
    }
    <section class="chapter feature" id="custom" data-section="custom">
      <div class="feature__head">
        <h2 class="chapter__title">No CSS ships. The markup is yours.</h2>
        <p class="feature__lede">
          The primitives carry behaviour, keyboard handling and ARIA. They
          import no stylesheet and render no chrome of their own, so there is
          no theme to fight and nothing to override.
        </p>
      </div>

      <div class="feature__body feature__body--reverse">
        <ul class="claims">
          <li class="claim">
            <b>Your classes.</b> Every primitive forwards
            {' '}<code>className</code>, <code>style</code> and its ref.
          </li>
          <li class="claim">
            <b>Your layout.</b> Nothing is positioned for you, and no
            primitive assumes where another one went.
          </li>
          <li class="claim">
            <b>Your elements.</b> Where a primitive would be in the way, take
            the state from a hook and render your own.
          </li>
          <li class="claim">
            <b>An opt-in theme.</b> One stylesheet, if you want somewhere to
            start rather than nothing.
          </li>
        </ul>

        <div class="code">
          <Code code={customSnippet} lang="tsx" {...shikiConfig} />
        </div>
      </div>
    </section>

    {
      /* ---- close ----------------------------------------------------------
       *
       * The install line and the ways onward. */
    }
    <section class="chapter close" id="close" data-section="close">
      <h2 class="chapter__title">Start with one line.</h2>
      <div class="cta close__cta">
        <div class="install" data-install>
          <code class="install__command" data-install-command>{install}</code>
          <button class="install__copy" type="button" hidden data-install-copy>
            Copy
          </button>
          <span class="u-visually-hidden" role="status" data-install-status
          ></span>
        </div>
      </div>
      <p class="close__links">
        <a href={referenceUrl}>Reference &rarr;</a>
        <a href={providersUrl}>Providers &rarr;</a>
        <a href={archetypesUrl}>Archetypes &rarr;</a>
        <a href={designUrl}>The visual system &rarr;</a>
      </p>
      <dl class="close__figures">
        <div class="close__figure">
          <dt>@playdeck/react</dt>
          <dd>{reactKb.toFixed(0)}<span class="close__unit">KB</span></dd>
        </div>
        <div class="close__figure">
          <dt>@playdeck/core</dt>
          <dd>{coreKb.toFixed(0)}<span class="close__unit">KB</span></dd>
        </div>
      </dl>
      <p class="close__fineprint">
        Gzipped, both, and measured by the same script CI fails the build with.
        React 19 as a peer dependency &middot; ESM only &middot; named exports.
      </p>
    </section>
  </main>
</Base>

<script>
  /**
   * Two independent pieces of behaviour, neither of which the page needs to
   * run at all: the entry motion, and the two install buttons. Both degrade
   * to a settled, readable page on their own — see each block for how.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- entry motion, the site-wide vocabulary -----------------------------
  //
  // `.u-enter` unchanged from the page this replaces — `base.css` carries the
  // full reasoning. Kept here rather than moved, because this page is still
  // the one `[data-stance='argument']` document that spends it.
  if (!reduced.matches) {
    const reveal = (selector: string, attribute: string) => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.removeAttribute(attribute);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '10000px 0px -10% 0px' }
      );

      for (const target of document.querySelectorAll(selector)) {
        if (target.getBoundingClientRect().top < window.innerHeight) continue;
        target.setAttribute(attribute, '');
        observer.observe(target);
      }
    };

    reveal('.u-enter', 'data-enter');
  }

  // ---- the install line's copy button, on both of its instances ----------
  const COPIED_MS = 2000;

  for (const group of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const command = group.querySelector<HTMLElement>('[data-install-command]');
    const button = group.querySelector<HTMLButtonElement>('[data-install-copy]');
    const status = group.querySelector<HTMLElement>('[data-install-status]');
    if (command === null || button === null || status === null) continue;

    if (!navigator.clipboard) continue;

    const idle = button.textContent ?? 'Copy';
    let restore: ReturnType<typeof setTimeout> | undefined;

    button.hidden = false;
    button.addEventListener('click', () => {
      const text = (command.textContent ?? '').trim();
      void navigator.clipboard.writeText(text).then(
        () => {
          button.textContent = 'Copied';
          status.textContent = `Copied ${text} to the clipboard.`;
        },
        () => {
          button.textContent = 'Press to select';
          status.textContent =
            'The clipboard refused. Select the command to copy it.';
          const range = document.createRange();
          range.selectNodeContents(command);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      );

      clearTimeout(restore);
      restore = setTimeout(() => {
        button.textContent = idle;
        status.textContent = '';
      }, COPIED_MS);
    });
  }
</script>

<style>
  .page {
    max-inline-size: 72rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }

  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    /* `--space-8`, not `--space-9`. The page ran to 4,420px for five short
       sections and a good part of that was the gap between them. */
    margin-block-start: var(--space-8);
    max-inline-size: 100%;
  }

  .chapter__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  /* ---- hero, an asymmetric split: thesis on one side, the running player on
   * the other. Stacked below 64rem, thesis first — a reader on a phone reads
   * the claim before they reach the instrument.
   *
   * The live report used to sit under the player in this same column, which
   * made the thesis column roughly half the height of the stage column: at
   * `align-items: center` that put ~440px of dead air above the thesis text.
   * The report now lives in the `truth` section below (see `Ledger` /
   * `LedgerPortal` in `HeroPlayerIsland.tsx`), so the stage column is the
   * player alone and the two columns are close enough in height for
   * `align-items: center` to read as a deliberate pairing rather than a
   * layout accident. */
  .hero {
    align-items: start;
    gap: var(--space-7);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-2);
  }

  .hero__thesis {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .hero {
      /* The player is the protagonist: its column carries more of the row's
       * width than the thesis column does, rather than the near-even split
       * this used to be. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      column-gap: var(--space-8);
      align-items: center;
    }
  }

  .hero__stage {
    display: grid;
    gap: var(--space-5);
    min-inline-size: 0;
  }

  /* The wordmark: display type, solid ink, nothing clipped or filled. A
   * gradient text-fill used to stand here; on screen it read as a rainbow
   * rather than a brand mark, so the weight this word carries now comes from
   * scale, weight and spacing alone — the same three levers every other
   * heading on this page uses. Sized to a headline that reads as one word
   * rather than a poster: a hero holding a live player beside it has no room
   * left for an 11rem letterform. */
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .thesis {
    max-inline-size: var(--measure);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    color: var(--color-ink-muted);
  }

  /* The five providers, as a row of names under the thesis rather than a
     section of their own further down. It is a fact about the library's scope
     and it belongs where the scope is claimed; as a section it was a heading,
     a strip, a sentence and two numbers spread over a screen's height, saying
     one thing slowly. Spaced by the gap rather than punctuated by middots: a
     separator between items is a mark a reader has to skip. */
  .hero__providers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-fn);
    color: var(--color-ink-subtle);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    min-block-size: var(--hit-target);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-sunken);
    border-radius: var(--radius-md);
  }

  .install__command {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .install__copy {
    flex: none;
    min-block-size: var(--space-6);
    padding-inline: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
    background-color: transparent;
    border: var(--line-width) solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .install__copy:hover {
    color: var(--color-ink);
  }

  .install__copy:active {
    color: var(--color-ink-subtle);
    border-color: var(--color-accent);
  }

  .cta__secondary {
    font-size: var(--text-md);
  }

  @media (scripting: none) {
    .hero__stage :global(noscript) {
      display: contents;
    }
  }

  /* ---- the feature sections ------------------------------------------------
   *
   * Four of them, one per feature, and they share a shape: a head that states
   * the claim, a body that shows the API, and a note under it. The head is a
   * vertical stack rather than a headline on the left with its explainer on the
   * right, because that split is the section-header pattern every generated
   * marketing page reaches for.
   *
   * What varies between them is the body, deliberately: two columns with the
   * code leading, one full-width block, two stacked players, two columns with
   * the code trailing. Four sections in a row with the same internal layout
   * would read as a template even with different words in them. */
  .feature__head {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--measure);
  }

  .feature__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .feature__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .feature__body {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: var(--space-7);
    }

