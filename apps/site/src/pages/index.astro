---
// The link is not decoration. `astro.config.ts` can only be shown to honour the
// base path by something on the page resolving against it, so the page carries
// the one link the site needs anyway — the workbench, which
// `.github/workflows/pages.yml` assembles under `storybook/` beside this page,
// and which `scripts/check-pages-artifact.mjs` follows from here in a browser.
// `import.meta.env.BASE_URL` is what Astro fills the configured `base` into, so
// a root-absolute `/storybook/` written by hand is exactly the bug the base
// path exists to prevent (#435).
const storybookUrl = `${import.meta.env.BASE_URL}storybook/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playdeck</title>
  </head>
  <body>
    <h1>Playdeck</h1>
    <p><a href={storybookUrl}>Storybook workbench</a></p>
  </body>
</html>
