---
import Base from '../../layouts/Base.astro';
import Sweep from '../../components/Sweep.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { referencePackages } from '../../reference-packages.mjs';

const packages = await referencePackages();

// Through `import.meta.env.BASE_URL` rather than as literals, for the reason
// `src/pages/index.astro` gives at length: the prefix is the root today, so a
// hand-written path would be identical and would stop being identical silently
// (#435).
const packageUrl = (dir) => `${import.meta.env.BASE_URL}reference/${dir}/`;
const startUrl = `${import.meta.env.BASE_URL}start/`;

// The scope every package on this index shares, taken from the names rather
// than written down, so a package published under a different scope one day
// stops being described by a line that says they all share this one.
const scope = '@playdeck/';
const scoped = packages.every((entry) => entry.name.startsWith(scope));

// The version, stated once when there is one version to state. These packages
// are released together, so every row carried the same figure and the
// repetition was the reason none of them was read. Derived rather than assumed:
// the day a package is released on its own, `common` is undefined and every row
// carries its own figure again — which is the only arrangement in which the
// figure is worth reading.
const versions = new Set(packages.map((entry) => entry.version));
const common = versions.size === 1 ? packages[0].version : undefined;
---

{
  /* Deliberately not "Playdeck". `scripts/check-deploy-artifact.mjs` identifies
   * the site's root document in a browser by a heading named exactly that, which
   * is how the deployed artifact is proven to serve the site rather than
   * something else at the origin root, and a second document answering to the
   * name would make that identification ambiguous. `src/pages/design.astro`
   * carries the same constraint. */
}
<Base title="Reference — Playdeck">
  <SiteHeader crumbs={[{ label: 'Reference' }]} />

  <main class="page">
    <h1>Reference</h1>
    <p class="lead">
      Every published package, rendered from the README that ships inside its own
      npm tarball. There is no second copy: the page and the file a reader gets
      from npm are the same text.
    </p>
    <Sweep form="accent" />

    {
      /* The way out of this page for the reader it is worst for (#547). This
       * index answers "which package is which" and cannot answer "which one do
       * I install", and a reader who arrives here from the landing page's pitch
       * has the second question. Above the list rather than under it, because a
       * reader who has already read eight names has answered it themselves. */
    }
    <p class="detour">
      New to the library? <a href={startUrl}>Start</a> is one package, one
      composition, and what each provider costs.
    </p>

    {
      /* The two facts that were repeated down the column, said once each above
       * it. A reader who wants to know what to type into `pnpm add` reads this
       * line and the row's own name; a reader scanning for the right package
       * reads only the part of each name that differs. */
    }
    <p class="summary">
      {scoped && (
        <>
          Published under <code>{scope}</code>
        </>
      )}
      {scoped && common !== undefined && ', '}
      {
        common !== undefined && (
          <>
            all at version <code class="u-tabular">{common}</code>
          </>
        )
      }.
    </p>

    {
      /* A list and not a grid of cards. Cards of identical size are the shape a
       * container reaches for when nothing has been decided about the contents,
       * and they cost a reader the one thing an index is for: every name close
       * enough to the next to compare in one glance. Rows separated by a
       * hairline, name aligned in its own column, no chrome. */
    }
    <ul class="packages">
      {
        packages.map((entry) => (
          <li class="package">
            <h2 class="package__name">
              <a href={packageUrl(entry.dir)}>
                {scoped ? (
                  <>
                    <span class="u-visually-hidden">{scope}</span>
                    {entry.name.slice(scope.length)}
                  </>
                ) : (
                  entry.name
                )}
              </a>
            </h2>
            <p class="package__description">{entry.description}</p>
            {common === undefined && (
              <p class="package__version">
                <span class="package__version-label">version</span>{' '}
                <code class="u-tabular">{entry.version}</code>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  /* Wider than the prose pages, because this one is a table of names rather
   * than a document: the measure that keeps a paragraph readable is the same
   * measure that would force a one-line description to wrap. */
  .page {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 52rem;
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  /* Held to the same measure as prose anywhere else on the site. It is set one
   * rung up, so the same inline size is fewer characters than the token was
   * measured at — which is the right direction for a lead: it is read once,
   * before the list, and a lead as wide as the page is what a paragraph at this
   * rung looks like when nobody has held it. */
  .lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-inline-size: var(--measure);
  }

  /* The detour to the quickstart. Held to the measure like every other
     paragraph on this site, and set at the body rung rather than the lead's:
     it is an aside for one kind of reader, and a second element at the lead's
     size would read as a second lead. */
  .detour {
    max-inline-size: var(--measure);
    color: var(--color-ink-muted);
  }

  /* The two facts that used to be repeated down the column, said once each. At
   * the caption rung, because neither is what a reader came for — they are what
   * a reader would otherwise have had to infer from a column of identical
   * lines. */
  .summary {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }

  .summary code {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .packages {
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: var(--line-width) solid var(--color-line);
  }

  /* Stacked below the breakpoint and two columns above it. The name column is
   * sized to the longest name the scope leaves behind — `provider-youtube` at
   * the mono body rung — so the descriptions all start on the same axis and the
   * eye reads down one edge. */
  .package {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-block-end: var(--line-width) solid var(--color-line);
  }

  @media (min-width: 40rem) {
    .package {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-2) var(--space-5);
      align-items: baseline;
    }

    /* Under the description rather than under the name, so the second column
     * stays one block. Only ever rendered when the versions differ. */
    .package__version {
      grid-column: 2;
    }
  }

  /* An identifier, so it is set in the mono face like every other identifier on
   * this site, and at the body rung rather than the section rung: a column of
   * names at `h2`'s own rung would out-shout the page's title, and the row's job
   * is to be compared with the rows around it rather than to be a heading
   * first. */
  .package__name {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-fn);
  }

  .package__name a {
    text-decoration: none;
  }

  /* Rest, hover and focus are the site's own; the row adds and removes an
   * underline, and the pressed state is `base.css`'s, which nothing here
   * outranks — the rules above name no colour. */
  .package__name a:hover {
    text-decoration: underline;
  }

  .package__description {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* Only rendered when the versions differ, which is when the figure carries
   * information. See the frontmatter. */
  .package__version {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }

  .package__version-label {
    font-family: var(--font-mono);
    font-size: var(--text-fn);
    letter-spacing: var(--tracking-fn);
  }

  .package__version code {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
