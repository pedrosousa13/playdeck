---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sweep from '../../components/Sweep.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { referencePackages } from '../../reference-packages.mjs';

// One page per package, each rendering that package's whole README. Splitting a
// README across a page per `##` was considered and rejected: the fences in these
// documents are generated from real files by `scripts/docs-examples.mjs` and the
// prose around them refers backwards and forwards freely, so cutting between two
// headings cuts sentences that were written to sit together. The sticky table of
// contents below is what a reader gets instead of a page break.
//
// The route parameter is `pkg` and not `package`, which is a reserved word: a
// destructured `package` is a syntax error in a module, and the name would only
// have appeared in this file anyway.
export const getStaticPaths = async () => {
  const packages = await referencePackages();
  return packages.map((current) => ({
    params: { pkg: current.dir },
    props: { current, packages }
  }));
};

const { current, packages } = Astro.props;

// Every link on this page goes through `import.meta.env.BASE_URL`, which is what
// Astro fills the configured `base` into, rather than being written as a
// literal. That prefix is the root today and the literals would be identical,
// which is precisely why the habit is worth keeping: the day the site moves
// under a prefix, a hand-written `/reference/` is the bug a base path exists to
// prevent (#435) and nothing would flag it (#523).
const referenceUrl = `${import.meta.env.BASE_URL}reference/`;
const packageUrl = (dir) => `${referenceUrl}${dir}/`;

const { Content, headings } = await render(current.entry);

// The table of contents, derived from the same parse that produced the
// document. Nothing here is a list of section names: a parallel list is exactly
// the drift this ticket exists to remove, and it would go stale the first time
// somebody renamed a heading in a README with no idea this page existed.
//
// Depth 1 is the README's own title, which is the page's `h1` and is already at
// the top of what the link would scroll to. Depth 4 is dropped as well: the
// rail's job is to let a reader jump to a section, and four levels of it restate
// the document's outline instead. A README that goes deeper still is rendered in
// full and simply not indexed past depth 3.
const contents = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);

// The scope every package here shares, taken from the names rather than written
// down. The rail shows what differs and states the prefix once above the list;
// each link keeps the whole name in its accessible name, because `core` on its
// own is not what the reader would say out loud.
const scope = '@playdeck/';
const scoped = packages.every((entry) => entry.name.startsWith(scope));
const railName = (name) => (scoped ? name.slice(scope.length) : name);
---

<Base title={`${current.name} — Playdeck reference`}>
  <SiteHeader
    crumbs={[
      { label: 'Reference', href: referenceUrl },
      { label: current.name }
    ]}
  />

  <div class="shell">
    {
      /* One `nav` holding both lists rather than two landmarks, because they
       * answer the same question at two scales: which document, and where in
       * it. The headings inside it are the labels a screen reader lists them
       * by. */
    }
    {
      /* `data-pagefind-ignore`, for the reason the site header carries it: the
       * package list and the table of contents are repeated on every reference
       * page, so indexed they would put the same navigation into the excerpt of
       * every result and make a package's name match every document. The
       * headings themselves are still indexed where they belong — in the
       * document below, which is where a result should land a reader. */
    }
    <nav class="rail" aria-label="Reference navigation" data-pagefind-ignore>
      {
        /* A disclosure, closed, which the script below opens for real once
         * there is a column to put it in.
         *
         * Stacked above the document on a phone, these two lists run to roughly
         * the height of a phone screen several times over — a link per package,
         * an entry per heading of the README and the version — so a reader who
         * followed a link to `/reference/core/` on a narrow screen scrolled past
         * the whole of the site's navigation before reaching the first word of
         * the document they asked for. Moving the rail below the document was
         * the other option and it is worse: the source order is what a screen
         * reader and a keyboard follow, and it would have put the navigation
         * somewhere neither of them meets it until after several hundred lines
         * of prose.
         *
         * `<details>` rather than a button and a script, because it is the
         * element the platform already made for this: the affordance, the
         * keyboard behaviour and the focus ring all arrive with no JavaScript,
         * and with none the page is a working closed disclosure at every width.
         *
         * What the script adds is the one thing CSS cannot do: change the
         * element's own state. The wide layout wants the rail permanently
         * revealed, and the ways to get there with CSS alone all reveal the
         * content while leaving the element closed — so a screen reader is told
         * "collapsed" about a list the reader is looking at, and at that width
         * the only control that could correct it has been taken out of the tree
         * as well. `open` is a property, not a presentation, and the accessible
         * state follows it; so the property is what gets set. */
      }
      <details class="rail__disclosure" data-rail>
        <summary class="rail__summary">
          <span class="rail__marker" aria-hidden="true">▸</span>Contents
        </summary>
        <div class="rail__inner">
          <section class="rail__group">
            {
              /* The label states the shared prefix once, and the list below it
               * carries only what differs. Repeated down a 16rem column, the
               * scope spent the width that tells `provider-vimeo` from
               * `provider-wistia` on characters identical in every row. */
            }
            <h2 class="rail__label">
              <span>Packages</span>
              {scoped && <code class="rail__scope">{scope}</code>}
            </h2>
            <ul class="rail__list">
              {
                packages.map((entry) => (
                  <li>
                    <a
                      href={packageUrl(entry.dir)}
                      aria-current={
                        entry.dir === current.dir ? 'page' : undefined
                      }
                    >
                      {scoped && <span class="u-visually-hidden">{scope}</span>}
                      {railName(entry.name)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="rail__group">
            <h2 class="rail__label"><span>On this page</span></h2>
            <ul class="rail__list rail__list--toc">
              {
                contents.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))
              }
            </ul>
          </section>

          {
            /* The version, at the foot of the rail rather than above the
             * document's own title. A line of small type sitting on top of an
             * `h1` is the eyebrow `DESIGN.md` names as a generated-interface
             * tell, and this one would have restated the heading underneath
             * it. */
          }
          <p class="rail__version">
            <span class="rail__version-label">version</span>{' '}
            <code class="u-tabular">{current.version}</code>
          </p>
        </div>
      </details>
    </nav>

    {
      /* `is:inline`, and written here rather than bundled, for the reason
       * `Base.astro`'s theme script is: a module script is deferred by
       * definition, so it would run after the document had already been laid
       * out and the rail would be seen to open. Inline and immediately after
       * the element, it runs while the parser is still working through the
       * page.
       *
       * It owns two things and they are the same decision seen twice: whether
       * the element is open, which is what assistive technology is told, and
       * `data-rail`, which is what the stylesheet keys the column layout off.
       * Neither is written without the other, so the announced state and the
       * visible state cannot disagree — at a narrow width a closed disclosure
       * with its summary, at a wide one an open element whose summary is gone
       * because there is nothing left for it to toggle.
       *
       * `60rem` is the same figure as the media queries in this file's
       * stylesheet, which is the drift worth naming: the two are a dozen lines
       * apart on purpose, because a query cannot read a custom property and
       * there is no way to state the breakpoint once.
       *
       * With no JavaScript at all nothing here runs, `data-rail` stays empty,
       * and the rules below it never match — leaving the closed disclosure the
       * markup already is, at every width, with its summary visible, keyboard
       * operable and announcing the state it is actually in. */
    }
    <script is:inline>
      {
        const rail = document.querySelector('[data-rail]');
        const columned = window.matchMedia('(min-width: 60rem)');

        const apply = () => {
          rail.open = columned.matches;
          rail.dataset.rail = columned.matches ? 'column' : 'disclosure';
        };

        apply();
        columned.addEventListener('change', apply);
      }
    </script>

    {
      /* `Content` is the README, compiled. Everything the reader sees below is
       * that file: this page contributes a measure, a heading rhythm and the
       * code-block styling in `base.css`, and not one word. */
    }
    <main class="doc">
      <Content />
    </main>
  </div>

  <footer class="foot">
    <div class="foot__rule"><Sweep form="hairline" /></div>
    <p>
      <a href={referenceUrl}>All packages</a>
    </p>
  </footer>
</Base>

<style>
  /* Rail and document, side by side on a wide screen and stacked below it. The
   * rail comes first in the source in both, so a reader arriving on a phone or
   * with a screen reader meets the contents before several hundred lines of
   * prose rather than after them. */
  .shell {
    display: grid;
    /* `minmax(0, 1fr)` and never a bare `auto`. An `auto` track is floored at
     * its content's max-content size, and the widest thing in a reference page
     * is a code fence whose line length is decided by `examples/` — so the
     * column grows to the longest line and the whole document scrolls sideways
     * on a phone. Flooring the track at zero hands the overflow back to the
     * `<pre>`, which has a scroller of its own. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    max-inline-size: 74rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5);
  }

  @media (min-width: 60rem) {
    .shell {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .rail {
    font-size: var(--text-sm);
  }

  /* The disclosure's own affordance: a row with a marker, a pointer target tall
   * enough to hit, and the site's focus ring from `base.css`. The default
   * triangle is replaced by one drawn from the same character in both states,
   * rotated — a `transform`, which is one of the two properties this site
   * animates, so it settles correctly with reduced motion. */
  .rail__summary {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--hit-target);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    cursor: pointer;
    background-color: var(--color-surface);
    border: var(--line-width) solid var(--color-line-strong);
    border-radius: var(--radius-md);
    list-style: none;
  }

  /* Belt and braces, and named as that rather than as a fact about a browser.
   * `list-style: none` above is what removes the marker in every engine this
   * has been opened in; WebKit once needed this pseudo element as well, and no
   * engine has been checked here to establish that it still does. The rule
   * costs one selector and removes a marker that is already gone, so it stays
   * until somebody has a reason to say otherwise. */
  .rail__summary::-webkit-details-marker {
    display: none;
  }

  /* An element in the markup rather than generated content, and hidden from
   * assistive technology rather than left to be read. Generated content is
   * announced — the breadcrumb separator in `SiteHeader.astro` relies on that
   * being so — and a marker announced here lands inside the accessible name of
   * the control itself, which becomes the glyph plus the word. The name is what
   * a reader hears before deciding whether this is the thing that opens the
   * navigation, so it is the word alone; the triangle is decoration on it. */
  .rail__marker {
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
    transition: transform var(--duration-fast) var(--ease);
  }

  .rail__disclosure[open] > .rail__summary > .rail__marker {
    transform: rotate(90deg);
  }

  .rail__summary:hover {
    color: var(--color-accent);
  }

  .rail__summary:active {
    color: var(--color-ink-subtle);
  }

  .rail__disclosure[open] > .rail__summary {
    margin-block-end: var(--space-4);
  }

  /* Sticky, and bounded by the viewport with its own scroller. A sticky element
   * taller than the window is the failure this guards: it pins at the top, its
   * tail hangs past the bottom edge, and page scrolling never brings that tail
   * back because the element is not moving. Capping the height and giving it a
   * scroller of its own means every entry stays reachable however many sections
   * the README it indexes turns out to have. */
  @media (min-width: 60rem) {
    /* Wide enough for a column, so the disclosure stops being one — but only
     * once the script has opened it for real. Keyed off the attribute that
     * script writes rather than off the width alone, because a summary hidden
     * at a width where nothing had opened the element would leave the rail
     * unreachable. */
    .rail__disclosure[data-rail='column'] > .rail__summary {
      display: none;
    }

    /* The chain a sticky element needs, and the reason the grid no longer
     * aligns its items to `start`. `position: sticky` travels inside its own
     * containing block, so an element exactly as tall as its parent has nowhere
     * to travel and simply scrolls away — which is what the rail did before
     * this, never sticking at any scroll offset. Each box between the grid row
     * and the sticky one is given the row's height instead: the rail by
     * stretching, the disclosure by asking for it.
     *
     * Unconditional, and that is the correction: a reader who opens the rail by
     * hand in an engine with no `::details-content`, or with no JavaScript in
     * any engine, gets a sticky element inside a box exactly its own height —
     * which is the original defect, kept alive for exactly those readers. */
    .rail,
    .rail__disclosure {
      block-size: 100%;
    }

    /* The third box in that chain, and the only part of it that is a pseudo
     * element the engine may not have. `::details-content` is the anonymous box
     * the user agent puts between a `<details>` and its content, so where it
     * exists the height has to pass through it; where it does not, there is no
     * box between the two and the two rules above are the whole chain. */
    @supports selector(::details-content) {
      .rail__disclosure::details-content {
        block-size: 100%;
      }
    }

    .rail__inner {
      position: sticky;
      inset-block-start: var(--space-5);
      max-block-size: calc(100vh - var(--space-7));
      overflow-y: auto;
      /* Thin, because the rail is 16rem wide and a platform-width bar down its
       * edge would read as a second column boundary. The colour is the root's. */
      scrollbar-width: thin;
      /* Room for the scrollbar the line above can produce, so a link's focus
       * ring is never clipped by the scroller's own edge. */
      padding-inline-end: var(--space-2);
    }
  }

  .rail__group + .rail__group {
    margin-block-start: var(--space-5);
  }

  /* An `h2` by role, so the rail's two lists are labelled in the document
   * outline, and at the caption rung rather than the section rung, because the
   * heading it labels is not competing with the README's own. Capitals are left
   * alone: a tracked uppercase label is the eyebrow tell in another position. */
  .rail__label {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    margin-block-end: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-subtle);
    letter-spacing: normal;
  }

  /* The shared prefix, stated once at the head of the column it was repeated
   * down. Regular weight, so it reads as the thing the names below complete
   * rather than as a second label. */
  .rail__scope {
    font-family: var(--font-mono);
    font-size: var(--text-fn);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-fn);
  }

  .rail__list {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .rail__list a {
    display: block;
    padding-block: var(--space-1);
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .rail__list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Pressed, restating `base.css`'s rule because the hover above outranks it. */
  .rail__list a:active {
    color: var(--color-ink-subtle);
  }

  /* Package names are identifiers and are set in the mono face wherever they
   * appear on this site. Here that also does the work of joining each one to
   * the `@playdeck/` above the column. */
  .rail__group:first-child .rail__list a {
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-fn);
  }

  /* The current package, marked by the same attribute that tells a screen
   * reader which one it is rather than by a class that only says it visually.
   * Weight and colour together, because colour alone is not a state. */
  .rail__list a[aria-current='page'] {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .rail__list--toc a {
    font-size: var(--text-xs);
  }

  /* Indent by the heading's own depth, so the rail carries the document's
   * hierarchy rather than flattening it. */
  .rail__list--toc li[data-depth='3'] a {
    padding-inline-start: var(--space-4);
  }

  .rail__version {
    margin-block-start: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }

  .rail__version-label {
    font-family: var(--font-mono);
    font-size: var(--text-fn);
    letter-spacing: var(--tracking-fn);
  }

  .rail__version code {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  /* The measure. These are pages of prose rather than a landing page, and a
   * paragraph the full width of a desktop window is the thing that makes a long
   * document unreadable — the eye loses the start of the next line. The code
   * blocks inside are allowed the full column, because a fence that wraps or
   * scrolls is worse than a wide one and `docs:check` decides how long its lines
   * are, not this file. */
  .doc {
    min-inline-size: 0;
    /* Inherited by everything in the document, and needed because these are
     * someone else's words: a package name is one unbroken token and
     * `@playdeck/provider-youtube` set at the `h1` rung is wider than a phone.
     * Without this the title alone gives the page a horizontal scrollbar, which
     * then moves the whole document rather than the one thing that did not fit.
     * It has no effect inside a fence, where nothing wraps in the first place. */
    overflow-wrap: break-word;
  }

  /* The measure, which is the token's job and not this page's to pick: it was
   * set to land a line of prose inside the 65–75 character band at the body
   * rung, and this is prose at the body rung. The value it replaced was under
   * that band — close enough to look right, and far enough out to be worth
   * changing. */
  .doc :global(p),
  .doc :global(ul),
  .doc :global(ol),
  .doc :global(blockquote) {
    max-inline-size: var(--measure);
  }

  /* Rendered Markdown carries none of the attributes Astro scopes this
   * stylesheet by — the scoping is stamped on this page's own elements, and
   * `Content` is compiled from a file in `packages/` — so every rule below the
   * container has to be `:global`. */
  .doc :global(h1) {
    margin-block-end: var(--space-4);
  }

  .doc :global(h2) {
    margin-block: var(--space-7) var(--space-3);
  }

  .doc :global(h3) {
    margin-block: var(--space-6) var(--space-2);
  }

  /* `base.css` stops at `h3`, so without this rule a README's fourth level
   * arrives at the browser's own default and reads as body text in bold. Styled
   * even though the rail stops indexing at depth 3: a heading a reader scrolls
   * past still has to look like one. It sits at the body rung and is separated
   * by weight, which is what a fourth level has left. */
  .doc :global(h4) {
    margin-block: var(--space-5) var(--space-2);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  /* `base.css` sets `p { margin: 0 }` for the site's laid-out pages, where the
   * gap belongs to the grid. A document is the case that rule does not cover:
   * its paragraphs are a stream and the space between them is the paragraph
   * break. */
  .doc :global(p),
  .doc :global(ul),
  .doc :global(ol),
  .doc :global(pre),
  .doc :global(blockquote),
  .doc :global(table) {
    margin-block: var(--space-4);
  }

  .doc :global(li) {
    margin-block: var(--space-2);
  }

  .doc :global(blockquote) {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--line-width) solid var(--color-line-strong);
    color: var(--color-ink-muted);
  }

  /* Inline code, set apart from the prose by a well rather than by colour: the
   * accent is the link colour on this site and an identifier is not a link. */
  .doc :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background-color: var(--color-sunken);
    border-radius: var(--radius-sm);
  }

  /* The READMEs carry wide tables of props and events. The scroller is on the
   * table rather than on the page, so a narrow window scrolls the table and
   * never the document. */
  .doc :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .doc :global(th),
  .doc :global(td) {
    padding: var(--space-2) var(--space-3);
    border-block-end: var(--line-width) solid var(--color-line);
    text-align: start;
    vertical-align: top;
  }

  .doc :global(th) {
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  /* A `hr` in a README is a section break in someone else's document, so it is
   * a hairline and not the chroma sweep: the sweep has exactly two forms and a
   * horizontal rule inside rendered prose is neither of them. */
  .doc :global(hr) {
    block-size: 0;
    margin-block: var(--space-6);
    border: 0;
    border-block-start: var(--line-width) solid var(--color-line);
  }

  .foot {
    max-inline-size: 74rem;
    margin-inline: auto;
    padding: 0 var(--space-5) var(--space-8);
    font-size: var(--text-sm);
  }

  /* The separator's spacing is this page's business; its thickness and its paint
   * are `Sweep.astro`'s. More above than below: a whole README ends over it,
   * and `.shell`'s bottom padding is the same figure as its top, which is the
   * gap the rail wanted rather than the gap a document's end does. */
  .foot__rule {
    margin-block: var(--space-7) var(--space-4);
  }
</style>
