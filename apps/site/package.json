{
  "name": "@playdeck/site",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node ../../scripts/media-sprite-fright.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "build:based": "node ../../scripts/media-sprite-fright.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build --base /playdeck/ --outDir dist-base && pagefind --site dist-base",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@playdeck/core": "workspace:*",
    "@playdeck/react": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "pagefind": "1.5.2",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
