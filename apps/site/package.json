{
  "name": "@playdeck/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "build:based": "ASTRO_TELEMETRY_DISABLED=1 astro build --base /playdeck/ --outDir dist-base && pagefind --site dist-base",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@playdeck/react": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "astro": "7.2.9",
    "pagefind": "1.5.2"
  }
}
