/thumbnails-sprite.svg#xywh=0,0,160,90

00:00:02.000 --> 00:00:04.000
/thumbnails-sprite.svg#xywh=160,0,160,90

00:00:04.000 --> 00:00:06.000
/thumbnails-sprite.svg#xywh=320,0,160,90

00:00:06.000 --> 00:00:08.000
/thumbnails-sprite.svg#xywh=480,0,160,90

00:00:08.000 --> 00:00:10.000
/thumbnails-sprite.svg#xywh=640,0,160,90
